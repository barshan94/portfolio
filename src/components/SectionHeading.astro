---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  id?: string;
  number?: string;
}
const { eyebrow, title, subtitle, id, number } = Astro.props as Props;
---

<section id={id} class="section-head reveal">
  {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
  <h2 class="section-title">
    {number && <span class="section-num">{number}</span>}
    {title}
  </h2>
  {subtitle && <p class="section-subtitle">{subtitle}</p>}
</section>

<style>
.section-head { max-width: 760px; }
.section-eyebrow {
  margin: 0 0 0.75rem;
  font-size: var(--step-1);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
}
.section-title {
  margin: 0;
  font-size: var(--step-7);
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: var(--ink);
  font-weight: 700;
  position: relative;
  display: inline-block;
}
.section-num {
  font-family: var(--font-mono);
  font-size: var(--step-2);
  font-weight: 500;
  color: var(--ink-faint);
  margin-right: 0.6em;
  vertical-align: middle;
}
.section-subtitle {
  margin: 1.1rem 0 0;
  font-size: var(--step-2);
  color: var(--ink-muted);
}
@media (max-width: 640px) {
  .section-title { font-size: var(--step-6); }
  .section-num { font-size: var(--step-1); }
}
</style>