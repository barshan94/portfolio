---
interface Props {
  role: string;
  org: string;
  period: string;
  bullets: string[];
  type?: "work" | "internship" | "project";
}
const { role, org, period, bullets, type = "work" } = Astro.props as Props;
const dotColor = type === "internship" ? "var(--accent-2)" : type === "project" ? "var(--warn)" : "var(--ink-muted)";
---

<div class="timeline-entry reveal">
  <div class="timeline-dot" style={`--color: ${dotColor}`}></div>
  <div class="timeline-body">
    <header class="timeline-header">
      <h3 class="timeline-role">{role}</h3>
      <span class="timeline-org">{org}</span>
    </header>
    <p class="timeline-period">{period}</p>
    <ul class="timeline-bullets">
      {bullets.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</div>

<style>
.timeline-entry {
  display: flex;
  gap: 1rem;
  position: relative;
  padding-bottom: 2rem;
}
.timeline-entry:last-child { padding-bottom: 0; }

.timeline-dot {
  width: 12px;
  height: 12px;
  min-width: 12px;
  margin-top: 0.45em;
  border-radius: 50%;
  background: var(--color, var(--ink-muted));
  border: 2px solid var(--bg);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--color, var(--ink-muted)) 30%, transparent);
}
.timeline-body { flex: 1; padding-left: 0.5rem; }
.timeline-header { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
.timeline-role { margin: 0; font-size: var(--step-2); font-weight: 600; color: var(--ink); }
.timeline-org { font-size: var(--step-1); color: var(--ink-2); font-weight: 500; }
.timeline-period { margin: 0.3rem 0 0.6rem; font-size: var(--step-1); color: var(--ink-muted); font-family: var(--font-mono); }
.timeline-bullets { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }
.timeline-bullets li {
  padding-left: 1.1rem;
  position: relative;
  font-size: var(--step-1);
  color: var(--ink-muted);
  line-height: 1.55;
}
.timeline-bullets li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.55em;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--line-strong);
}
</style>