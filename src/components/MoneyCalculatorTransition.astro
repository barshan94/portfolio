.mc-corner{position:absolute;color:#85a9ab88;font-size:.42rem;letter-spacing:.07em}.mc-corner.a{top:12px;left:14px}.mc-corner.b{top:12px;right:14px}.mc-corner.c{bottom:12px;left:14px}.mc-corner.d{bottom:12px;right:14px}.mc-phase{display:inline-flex;align-items:center;gap:7px;min-width:0;color:var(--teal)}.mc-phase-text{overflow:hidden;color:#7f969a;text-overflow:ellipsis;white-space:nowrap}.mc-controls{border-top:1px solid #1b2b2e}.mc-controls button{min-height:30px;margin-left:5px;padding:0 10px;border:1px solid #7ba9ac3b;border-radius:3px;color:#c3d6d5;background:#101b20;font:inherit;font-size:.58rem;cursor:pointer}.mc-controls button:hover,.mc-controls button:focus-visible{border-color:var(--teal);color:var(--teal);outline:none}.mc-note{margin:0;padding:0 16px 13px;color:#667e82;font-size:.56rem;line-height:1.6}.mc-transition.is-paused .mc-stage *{animation-play-state:paused!important}
@keyframes mc-left{from{opacity:0;transform:translateX(-12px)}to{opacity:1;transform:none}}@keyframes mc-row{to{opacity:1}}@keyframes mc-focus{from{opacity:0;filter:blur(7px)}to{opacity:1;filter:none}}@keyframes mc-orbit{to{rotate:360deg}}@keyframes mc-up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes mc-title{from{opacity:0;transform:translateY(12px);clip-path:inset(0 0 100%)}to{opacity:1;transform:none;clip-path:inset(0)}}@keyframes mc-fill{to{background:var(--teal)}}@keyframes mc-blink{to{opacity:0}}
