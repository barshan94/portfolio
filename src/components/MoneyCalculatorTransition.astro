---
// MoneyCalculatorTransition.astro
---

<div class="mc-container">
  <div class="mc-topline">
    <span class="mc-badge">DEMO DATA / BDT</span>
    <span class="mc-status">SYNCED</span>
  </div>

  <div class="mc-stage">
    <canvas class="mc-canvas" aria-hidden="true"></canvas>
    
    <div class="mc-ledger">
      <div class="ledger-header">Recent Transactions</div>
      <div class="ledger-items">
        <div class="ledger-item positive">+42,000</div>
        <div class="ledger-item positive">+6,500</div>
        <div class="ledger-item negative">-12,800</div>
        <div class="ledger-item neutral">8,000</div>
        <div class="ledger-item positive">+2,000</div>
      </div>
    </div>

    <div class="mc-engine">
      <div class="mc-emblem">MC</div>
    </div>

    <div class="mc-balance">
      <span class="currency-label">BDT</span>
      <span class="balance-amount">1,425,850</span>
    </div>

    <div class="mc-title">
      <h3>Financial Engine</h3>
      <p>Cinematic Ledger Simulation</p>
    </div>

    <div class="mc-corner top-left">SYS.01</div>
    <div class="mc-corner bottom-right">SECURE</div>
  </div>

  <div class="mc-controls">
    <button id="mc-replay" type="button" class="mc-btn">Replay</button>
    <button id="mc-pause" type="button" class="mc-btn">Pause</button>
  </div>

  <div class="mc-note">
    Disclaimer: This animation uses sample figures and is not live account data.
  </div>
</div>

<script>
  class MoneyCalculatorEngine {
    container: HTMLElement;
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D | null;
    replayBtn: HTMLButtonElement | null;
    pauseBtn: HTMLButtonElement | null;
    isPaused: boolean = false;
    animId: number | null = null;
    particles: Array<{x: number, y: number, vx: number, vy: number, size: number, alpha: number}> = [];

    constructor(container: HTMLElement) {
      this.container = container;
      this.canvas = container.querySelector('.mc-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas ? this.canvas.getContext('2d') : null;
      this.replayBtn = container.querySelector('#mc-replay');
      this.pauseBtn = container.querySelector('#mc-pause');
      
      this.init();
    }

    init() {
      if (!this.canvas || !this.ctx) return;
      this.resize();
      this.createParticles();
      this.bindEvents();
      this.animate();
    }

    resize() {
      if (!this.canvas) return;
      const rect = this.canvas.getBoundingClientRect();
      this.canvas.width = rect.width || 600;
      this.canvas.height = rect.height || 400;
    }

    createParticles() {
      this.particles = [];
      const count = 35;
      for (let i = 0; i < count; i++) {
        this.particles.push({
          x: Math.random() * this.canvas.width,
          y: Math.random() * this.canvas.height,
          vx: (Math.random() - 0.5) * 0.8,
          vy: (Math.random() - 0.5) * 0.8,
          size: Math.random() * 2 + 1,
          alpha: Math.random() * 0.5 + 0.2
        });
      }
    }

    bindEvents() {
      window.addEventListener('resize', () => this.resize());
      
      if (this.replayBtn) {
        this.replayBtn.addEventListener('click', () => {
          this.createParticles();
          this.isPaused = false;
          if (this.pauseBtn) this.pauseBtn.textContent = 'Pause';
        });
      }

      if (this.pauseBtn) {
        this.pauseBtn.addEventListener('click', () => {
          this.isPaused = !this.isPaused;
          this.pauseBtn.textContent = this.isPaused ? 'Resume' : 'Pause';
        });
      }
    }

    animate() {
      if (!this.ctx || !this.canvas) return;
      
      if (!this.isPaused) {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        
        this.ctx.strokeStyle = 'rgba(16, 185, 129, 0.1)';
        this.ctx.lineWidth = 1;
        
        for (let p of this.particles) {
          p.x += p.vx;
          p.y += p.vy;
          
          if (p.x < 0) p.x = this.canvas.width;
          if (p.x > this.canvas.width) p.x = 0;
          if (p.y < 0) p.y = this.canvas.height;
          if (p.y > this.canvas.height) p.y = 0;

          this.ctx.fillStyle = `rgba(16, 185, 129, ${p.alpha})`;
          this.ctx.beginPath();
          this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          this.ctx.fill();
        }
      }

      this.animId = requestAnimationFrame(() => this.animate());
    }
  }

  document.querySelectorAll('.mc-container').forEach(el => {
    new MoneyCalculatorEngine(el as HTMLElement);
  });
</script>

<style>
  .mc-container {
    background: #09090b;
    border: 1px solid #27272a;
    border-radius: 1rem;
    padding: 1.5rem;
    color: #f4f4f5;
    font-family: ui-sans-serif, system-ui, sans-serif;
    width: 100%;
    box-sizing: border-box;
  }

  .mc-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: #a1a1aa;
    margin-bottom: 1rem;
  }

  .mc-badge {
    background: rgba(16, 185, 129, 0.1);
    color: #34d399;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .mc-status {
    color: #34d399;
    font-weight: 600;
  }

  .mc-stage {
    position: relative;
    width: 100%;
    min-height: 380px;
    background: #18181b;
    border-radius: 0.75rem;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 1rem;
    padding: 1.5rem;
    align-items: center;
    justify-items: center;
  }

  .mc-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .mc-ledger {
    z-index: 2;
    background: rgba(24, 24, 27, 0.85);
    border: 1px solid #27272a;
    border-radius: 0.5rem;
    padding: 0.75rem;
    width: 100%;
    max-width: 220px;
    justify-self: start;
    align-self: center;
  }

  .ledger-header {
    font-size: 0.7rem;
    color: #a1a1aa;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid #27272a;
    padding-bottom: 0.25rem;
  }

  .ledger-items {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-family: monospace;
  }

  .ledger-item.positive { color: #34d399; }
  .ledger-item.negative { color: #f87171; }
  .ledger-item.neutral { color: #d4d4d8; }

  .mc-engine {
    z-index: 2;
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #059669, #10b981);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.4);
    justify-self: center;
    align-self: center;
  }

  .mc-emblem {
    font-weight: bold;
    font-size: 1.25rem;
    color: #ffffff;
  }

  .mc-balance {
    z-index: 2;
    background: rgba(9, 9, 11, 0.9);
    border: 1px solid #27272a;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    justify-self: center;
    align-self: center;
  }

  .currency-label {
    font-size: 0.75rem;
    color: #a1a1aa;
    font-weight: 600;
  }

  .balance-amount {
    font-size: 1.1rem;
    font-weight: bold;
    color: #ffffff;
    font-family: monospace;
  }

  .mc-title {
    z-index: 2;
    justify-self: end;
    align-self: center;
    text-align: right;
  }

  .mc-title h3 {
    font-size: 1.1rem;
    font-weight: bold;
    color: #ffffff;
    margin: 0;
  }

  .mc-title p {
    font-size: 0.75rem;
    color: #a1a1aa;
    margin: 0;
  }

  .mc-corner {
    position: absolute;
    font-size: 0.65rem;
    color: #52525b;
    font-family: monospace;
    z-index: 2;
    pointer-events: none;
  }
  .mc-corner.top-left { top: 0.5rem; left: 0.75rem; }
  .mc-corner.bottom-right { bottom: 0.5rem; right: 0.75rem; }

  .mc-controls {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .mc-btn {
    background: #27272a;
    color: #f4f4f5;
    border: 1px solid #3f3f46;
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .mc-btn:hover {
    background: #3f3f46;
  }

  .mc-note {
    font-size: 0.7rem;
    color: #71717a;
    margin-top: 0.75rem;
  }

  @media (max-width: 760px) {
    .mc-stage {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto;
      justify-items: stretch;
      padding: 1rem;
      min-height: auto;
    }

    .mc-ledger {
      max-width: 100%;
      justify-self: stretch;
    }

    .mc-title {
      text-align: left;
      justify-self: start;
    }

    .mc-engine, .mc-balance {
      justify-self: center;
    }
  }

  @media (max-width: 440px) {
    .mc-container {
      padding: 1rem;
    }
    .balance-amount {
      font-size: 0.95rem;
    }
  }
</style>
