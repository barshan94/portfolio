@media(max-width:440px){.mc-stage{min-height:430px}.mc-topline,.mc-controls{padding-inline:9px;font-size:.47rem}.mc-ledger{top:15%;left:3%;width:53%}.mc-engine{top:58%;left:35%;width:45%}.mc-title{top:14%;right:3%;width:41%}.mc-title>strong{font-size:clamp(1.45rem,7vw,2rem);letter-spacing:-.08em}.mc-title>small{font-size:.36rem}.mc-title>p{font-size:.5rem;line-height:1.4}.mc-balance{right:3%;bottom:10%;width:42%}.mc-controls button{padding-inline:6px;font-size:.51rem}.mc-note{padding-inline:9px;font-size:.51rem}}
@media(prefers-reduced-motion:reduce){.mc-transition *,.mc-transition *:before,.mc-transition *:after{animation-duration:.01ms!important;animation-iteration-count:1!important}}
</style>
<script>
  document.querySelectorAll(".mc-transition:not([data-ready])").forEach((root) => {
    root.setAttribute("data-ready","true");
    const canvas=root.querySelector(".mc-canvas"), stage=root.querySelector(".mc-stage"), replay=root.querySelector(".mc-replay"), pause=root.querySelector(".mc-pause"), label=root.querySelector(".mc-phase-text"), counter=root.querySelector(".mc-counter"), ctx=canvas?.getContext("2d");
    if(!canvas||!stage||!ctx)return;
    const reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let w=1,h=1,raf=0,start=0,elapsed=0,paused=reduced,visible=true;
    const duration=7200, dots=Array.from({length:52},(_,i)=>({lane:i%9/8,offset:i*.173%1,speed:.12+(i*7%13)/100,blue:i%5===0,size:.8+i%3*.45}));
    function draw(ms){elapsed=ms;ctx.clearRect(0,0,w,h);const g=ctx.createRadialGradient(w*.49,h*.53,2,w*.49,h*.53,w*.42);g.addColorStop(0,"rgba(47,190,161,.06)");g.addColorStop(1,"rgba(4,10,14,0)");ctx.fillStyle=g;ctx.fillRect(0,0,w,h);const t=ms/1000;
      ctx.strokeStyle="rgba(93,180,172,.14)";ctx.beginPath();ctx.moveTo(w*.04,h*.5);ctx.bezierCurveTo(w*.3,h*.5,w*.35,h*.53,w*.49,h*.53);ctx.bezierCurveTo(w*.65,h*.53,w*.7,h*.5,w*.96,h*.5);ctx.stroke();
      dots.forEach((p,i)=>{const x=w*(.04+((p.offset+t*p.speed)%1)*.92),y=h*(.13+p.lane*.74)+Math.sin(t*1.6+i)*8,a=.15+(Math.sin(t*2+i)+1)*.18;ctx.fillStyle=p.blue?`rgba(91,156,255,${a})`:`rgba(88,224,194,${a})`;ctx.beginPath();ctx.arc(x,y,p.size,0,Math.PI*2);ctx.fill();if(i%4===0){ctx.strokeStyle=ctx.fillStyle;ctx.beginPath();ctx.moveTo(x-25,y);ctx.lineTo(x,y);ctx.stroke();}});
      for(let i=0;i<3;i++){ctx.beginPath();ctx.ellipse(w*.49,h*.53,Math.min(w*.12,h*.22)*(1+i*.24),Math.min(w*.12,h*.22)*(.34+i*.18),t*(i%2?-.22:.18),0,Math.PI*2);ctx.strokeStyle=i===1?"rgba(91,156,255,.18)":"rgba(88,224,194,.18)";ctx.stroke();}
      if(counter)counter.textContent=Math.round(Math.max(0,Math.min(1,(ms/duration-.35)/.45))*58500).toLocaleString("en-US").padStart(6,"0");
      if(label)label.textContent=ms<1150?"INITIALIZING FINANCIAL ENGINE":ms<2800?"LINKING TRANSACTION RECORDS":ms<4700?"RECONCILING ACCOUNT BALANCES":ms<6300?"VERIFYING LEDGER INTEGRITY":"MONEY CALCULATOR / READY";
    }
    function resize(){const r=stage.getBoundingClientRect(),dpr=Math.min(devicePixelRatio||1,2);w=Math.max(1,r.width);h=Math.max(1,r.height);canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);draw(elapsed);}
    function stop(){if(raf)cancelAnimationFrame(raf);raf=0;}
    function tick(now){if(!start)start=now;if(paused||!visible)return;const ms=now-start;draw(ms);if(ms>=duration){paused=true;if(pause){pause.textContent="â†» Replay";pause.setAttribute("aria-pressed","true");}return;}raf=requestAnimationFrame(tick);}
    function play(){if(reduced){draw(duration);return;}paused=false;start=performance.now()-elapsed;root.classList.remove("is-paused");if(pause){pause.textContent="â…¡ Pause";pause.setAttribute("aria-pressed","false");}stop();raf=requestAnimationFrame(tick);}
    replay?.addEventListener("click",()=>{stop();elapsed=0;start=0;play();});
    pause?.addEventListener("click",()=>{if(reduced)return;if(paused){play();}else{paused=true;stop();root.classList.add("is-paused");if(pause){pause.textContent="â–¶ Resume";pause.setAttribute("aria-pressed","true");}}});
    const io=new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;if(visible&&!paused&&!reduced){start=performance.now()-elapsed;stop();raf=requestAnimationFrame(tick);}else if(!visible)stop();},{threshold:.05});io.observe(root);
    const ro=new ResizeObserver(resize);ro.observe(stage);resize();if(reduced){root.classList.add("is-paused");draw(duration);if(pause)pause.disabled=true;}else play();
  });
</script>