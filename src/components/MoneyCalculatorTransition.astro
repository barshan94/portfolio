<script>
(() => {
  document.querySelectorAll(".mc-transition:not([data-ready])").forEach((root) => {
    root.setAttribute("data-ready", "true");

    const stage = root.querySelector(".mc-stage");
    const replay = root.querySelector(".mc-replay");
    const pause = root.querySelector(".mc-pause");
    const label = root.querySelector(".mc-phase-text");
    const counter = root.querySelector(".mc-counter");
    const status = root.querySelector(".mc-entry-status");
    const progress = root.querySelector(".mc-progress span");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const duration = 7200;

    let elapsed = 0;
    let startedAt = 0;
    let frame = 0;
    let paused = false;
    let visible = true;
    let destroyed = false;

    const numberFormat = new Intl.NumberFormat("en-US", {
      minimumIntegerDigits: 6,
      maximumFractionDigits: 0
    });

    function render(ms) {
      elapsed = Math.max(0, Math.min(ms, duration));

      const ratio = elapsed / duration;
      const amount = Math.round(58500 * Math.max(0, Math.min(1, (ratio - .35) / .45)));

      if (counter) counter.textContent = numberFormat.format(amount);
      if (progress) progress.style.width = `${ratio * 100}%`;

      if (label) {
        label.textContent =
          ratio < .16 ? "INITIALIZING FINANCIAL ENGINE" :
          ratio < .39 ? "LINKING TRANSACTION RECORDS" :
          ratio < .65 ? "RECONCILING ACCOUNT BALANCES" :
          ratio < .88 ? "VERIFYING LEDGER INTEGRITY" :
          "MONEY CALCULATOR / READY";
      }

      if (status) {
        status.textContent = ratio >= 1 ? "ALL RECORDS RECONCILED" :
          ratio >= .65 ? "VERIFYING BALANCES" :
          ratio >= .25 ? "LINKING RECORDS" :
          "AWAITING RECORDS";
      }
    }

    function stopFrame() {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    }

    function updateButtons() {
      if (!pause) return;

      pause.textContent = elapsed >= duration
        ? "Replay"
        : paused ? "Resume" : "Pause";

      pause.setAttribute("aria-pressed", String(paused));
    }

    function tick(now) {
      frame = 0;

      if (destroyed || paused || !visible) return;

      elapsed = now - startedAt;
      render(elapsed);

      if (elapsed >= duration) {
        elapsed = duration;
        paused = true;
        root.classList.add("is-finished", "is-paused");
        render(duration);
        updateButtons();
        return;
      }

      frame = requestAnimationFrame(tick);
    }

    function play() {
      if (destroyed) return;

      if (reducedMotion.matches) {
        paused = true;
        elapsed = duration;
        root.classList.add("is-paused", "is-finished");
        render(duration);
        updateButtons();
        return;
      }

      if (elapsed >= duration) elapsed = 0;

      paused = false;
      root.classList.remove("is-paused", "is-finished");

      startedAt = performance.now() - elapsed;
      updateButtons();
      stopFrame();

      if (visible) frame = requestAnimationFrame(tick);
    }

    function restart() {
      stopFrame();
      elapsed = 0;
      startedAt = 0;

      // Restart the decorative CSS animations as well as the counter.
      root.classList.remove("is-paused", "is-finished");
      void stage.offsetWidth;

      if (reducedMotion.matches) {
        paused = true;
        elapsed = duration;
        root.classList.add("is-paused", "is-finished");
        render(duration);
        updateButtons();
        return;
      }

      render(0);
      play();
    }

    replay?.addEventListener("click", restart);

    pause?.addEventListener("click", () => {
      if (reducedMotion.matches || elapsed >= duration) {
        restart();
        return;
      }

      if (paused) {
        play();
      } else {
        paused = true;
        stopFrame();
        root.classList.add("is-paused");
        updateButtons();
      }
    });

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;

      if (!visible) {
        stopFrame();
      } else if (!paused && !reducedMotion.matches) {
        startedAt = performance.now() - elapsed;
        stopFrame();
        frame = requestAnimationFrame(tick);
      }
    }, { threshold: .05 });

    observer.observe(root);

    const onMotionChange = () => {
      if (reducedMotion.matches) {
        stopFrame();
        paused = true;
        elapsed = duration;
        root.classList.add("is-paused", "is-finished");
        render(duration);
        updateButtons();
      } else {
        restart();
      }
    };

    reducedMotion.addEventListener?.("change", onMotionChange);

    render(0);

    if (reducedMotion.matches) {
      paused = true;
      elapsed = duration;
      root.classList.add("is-paused", "is-finished");
      render(duration);
    } else {
      play();
    }

    updateButtons();
  });
})();
</script>
