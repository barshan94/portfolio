---
interface Props {
  profile?: any;
  projects?: any[];
}

const { profile, projects = [] } = Astro.props;
const experience = profile?.experience ?? [];
const education = profile?.education ?? [];
const skills = profile?.skills ?? [];
const contact = profile?.contact ?? {};
const featuredProjects = projects.slice(0, 4);
---

<main class="animated-cv-shell">
  <header class="cv-topbar">
    <a class="cv-brand" href="/" aria-label="Back to Barshan Ghosh portfolio">
      <span class="brand-mark">BG</span>
      <span>BARSHAN GHOSH <small>ENGINEERING PORTFOLIO</small></span>
    </a>
    <div class="cv-topbar-actions">
      <span class="live-indicator"><i></i> CAREER OVERVIEW</span>
      <a href="/" class="back-link">Back to portfolio ↗</a>
    </div>
  </header>

  <section class="cv-hero reveal">
    <p class="eyebrow"><span></span> ANIMATED CURRICULUM VITAE</p>
    <h1>Building useful systems.<br /><em>Solving real problems.</em></h1>
    <p class="cv-intro">{profile?.headline ?? "Software engineering, financial systems, and applied AI."}</p>
    <div class="role-row">
      {(profile?.role ?? "Software Engineering · Full-Stack Development · Applied AI").split("·").map((role: string) => (
        <span>{role.trim()}</span>
      ))}
    </div>
    <div class="hero-bottom">
      <span>BASED IN NARAYANGANJ, BANGLADESH</span>
      <span>SOFTWARE · SYSTEMS · AI</span>
    </div>
  </section>

  <section class="cv-section reveal" aria-labelledby="experience-heading">
    <div class="section-label"><span>01</span><p>PROFESSIONAL JOURNEY</p></div>
    <div class="section-main">
      <h2 id="experience-heading">Experience that connects <em>technology and people.</em></h2>
      <div class="timeline">
        {experience.map((item: any, index: number) => (
          <article class="timeline-item" style={`--item-index:${index}`}>
            <div class="timeline-marker"><span>{String(index + 1).padStart(2, "0")}</span></div>
            <div class="timeline-content">
              <div class="timeline-meta">
                <span>{item.period}</span>
                {item.employmentType && <span class="employment-type">{item.employmentType}</span>}
              </div>
              <h3>{item.role}</h3>
              <p class="organization">{item.org}{item.location ? ` · ${item.location}` : ""}</p>
              {item.bullets?.length > 0 && (
                <ul>
                  {item.bullets.map((bullet: string) => <li>{bullet}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {education.length > 0 && (
    <section class="cv-section reveal" aria-labelledby="education-heading">
      <div class="section-label"><span>02</span><p>EDUCATION</p></div>
      <div class="section-main">
        <h2 id="education-heading">A foundation in <em>computer science.</em></h2>
        <div class="education-grid">
          {education.map((item: any) => (
            <article class="education-card">
              <span class="education-period">{item.period ?? item.duration ?? "Education"}</span>
              <h3>{item.degree}</h3>
              <p>{item.institution}</p>
              {item.cgpa && <strong>CGPA {item.cgpa}</strong>}
              {item.gpa && <strong>GPA {item.gpa}</strong>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {skills.length > 0 && (
    <section class="cv-section reveal" aria-labelledby="skills-heading">
      <div class="section-label"><span>03</span><p>TECHNICAL TOOLKIT</p></div>
      <div class="section-main">
        <h2 id="skills-heading">Tools for <em>practical work.</em></h2>
        <div class="skills-grid">
          {skills.map((skill: any, index: number) => (
            <article class="skills-card">
              <span class="skills-number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{skill.group ?? skill.category ?? skill.name}</h3>
              <div class="skill-chips">
                {(skill.items ?? skill.skills ?? []).map((item: string) => <span>{item}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section class="cv-section reveal" aria-labelledby="projects-heading">
      <div class="section-label"><span>04</span><p>SELECTED WORK</p></div>
      <div class="section-main">
        <h2 id="projects-heading">Ideas turned into <em>working systems.</em></h2>
        <div class="projects-grid">
          {featuredProjects.map((project: any, index: number) => (
            <article class="project-tile">
              <span>PROJECT / {String(index + 1).padStart(2, "0")}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              {project.tags?.length > 0 && <div class="project-tags">{project.tags.slice(0, 4).map((tag: string) => <span>{tag}</span>)}</div>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <footer class="cv-footer reveal">
    <div>
      <p class="eyebrow">LET'S CONNECT</p>
      <h2>Have a meaningful problem<br /><em>to solve?</em></h2>
    </div>
    <div class="footer-links">
      {contact.email && <a href={`mailto:${contact.email}`}>{contact.email} ↗</a>}
      {contact.github && <a href={contact.github} target="_blank" rel="noreferrer">GitHub ↗</a>}
      {contact.linkedin && <a href={contact.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>}
    </div>
  </footer>
</main>

<script>
  const revealItems = document.querySelectorAll(".animated-cv-shell .reveal");
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  } else {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -30px 0px" });
    revealItems.forEach((item) => revealObserver.observe(item));
  }
</script>

<style>
  :global(body) { background: #07090d; color: #eef3fa; }
  .animated-cv-shell { --bg: #07090d; --panel: #0d121c; --line: rgba(157,177,211,.16); --muted: #94a1b5; --mint: #7ce5d2; --violet: #9caeff; max-width: 1440px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 76px) 52px; font-family: Inter, system-ui, sans-serif; }
  .cv-topbar { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--line); }
  .cv-brand { display: flex; align-items: center; gap: 12px; color: #edf2fa; text-decoration: none; font-size: .75rem; font-weight: 800; letter-spacing: .12em; }
  .brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgba(124,229,210,.45); border-radius: 11px; color: var(--mint); font-size: .8rem; letter-spacing: 0; }
  .cv-brand small { display: block; margin-top: 4px; color: var(--muted); font: 500 .58rem/1.4 "JetBrains Mono", monospace; }
  .cv-topbar-actions { display: flex; align-items: center; gap: 24px; }
  .live-indicator, .back-link { color: var(--muted); font: 500 .65rem/1.5 "JetBrains Mono", monospace; text-decoration: none; }
  .live-indicator { display: flex; align-items: center; gap: 9px; letter-spacing: .08em; }
  .live-indicator i, .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 14px rgba(124,229,210,.6); }
  .back-link { color: var(--mint); }
  .cv-hero { position: relative; padding: clamp(66px, 10vw, 136px) 0 42px; border-bottom: 1px solid var(--line); overflow: hidden; }
  .cv-hero::after { position: absolute; z-index: -1; top: 5%; right: -8%; width: min(55vw, 660px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(124,229,210,.11), transparent 68%); content: ""; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: var(--mint); font: 500 .68rem/1.5 "JetBrains Mono", monospace; letter-spacing: .14em; }
  .cv-hero h1 { margin: 26px 0 20px; font-family: "Space Grotesk", Inter, sans-serif; font-size: clamp(2.8rem, 7.6vw, 7rem); font-weight: 700; line-height: .99; letter-spacing: -.065em; }
  em { color: var(--mint); font-style: normal; }
  .cv-intro { max-width: 650px; color: #b3bed0; font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.8; }
  .role-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .role-row span, .skill-chips span, .project-tags span { border: 1px solid var(--line); border-radius: 999px; padding: 8px 11px; color: #b7c3d6; font-size: .72rem; }
  .hero-bottom { display: flex; justify-content: space-between; gap: 20px; margin-top: 74px; color: #758399; font: 500 .62rem/1.5 "JetBrains Mono", monospace; letter-spacing: .1em; }
  .cv-section { display: grid; grid-template-columns: minmax(145px, .3fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 80px); padding: clamp(54px, 7vw, 92px) 0; border-bottom: 1px solid var(--line); }
  .section-label { display: flex; align-items: flex-start; gap: 12px; color: #8d9bb0; font: 500 .66rem/1.6 "JetBrains Mono", monospace; letter-spacing: .08em; }
  .section-label span { color: var(--mint); }
  .section-label p { margin: 0; }
  .section-main h2, .cv-footer h2 { margin: 0 0 34px; font-family: "Space Grotesk", Inter, sans-serif; font-size: clamp(1.8rem, 3.6vw, 3.4rem); line-height: 1.08; letter-spacing: -.045em; }
  .timeline { border-top: 1px solid var(--line); }
  .timeline-item { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 16px; padding: 26px 0; border-bottom: 1px solid var(--line); animation-delay: calc(var(--item-index, 0) * 70ms); }
  .timeline-marker { padding-top: 4px; }
  .timeline-marker span { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid rgba(124,229,210,.3); border-radius: 50%; color: var(--mint); font: 500 .65rem "JetBrains Mono", monospace; }
  .timeline-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--mint); font: 500 .68rem/1.6 "JetBrains Mono", monospace; }
  .employment-type { padding: 3px 8px; border: 1px solid var(--line); border-radius: 999px; color: #a3afc3; font-size: .61rem; }
  .timeline-content h3 { margin: 11px 0 5px; font-size: clamp(1.05rem, 1.6vw, 1.35rem); letter-spacing: -.02em; }
  .organization { margin: 0; color: #a6b4c8; font-size: .87rem; }
  .timeline-content ul { display: grid; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
  .timeline-content li { position: relative; padding-left: 16px; color: var(--muted); font-size: .86rem; line-height: 1.75; }
  .timeline-content li::before { position: absolute; top: .72em; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--mint); content: ""; }
  .education-grid, .skills-grid, .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .education-card, .skills-card, .project-tile { min-width: 0; padding: 22px; border: 1px solid var(--line); border-radius: 14px; background: linear-gradient(145deg, rgba(18,27,42,.85), rgba(9,14,22,.9)); }
  .education-period, .project-tile > span, .skills-number { color: var(--mint); font: 500 .65rem/1.5 "JetBrains Mono", monospace; letter-spacing: .06em; }
  .education-card h3, .skills-card h3, .project-tile h3 { margin: 15px 0 8px; font-size: 1rem; line-height: 1.45; }
  .education-card p, .project-tile p { margin: 0; color: var(--muted); font-size: .84rem; line-height: 1.7; }
  .education-card strong { display: inline-block; margin-top: 13px; color: #d5e4f1; font-size: .78rem; }
  .skills-card h3 { margin-top: 12px; }
  .skill-chips, .project-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; }
  .skill-chips span, .project-tags span { padding: 5px 8px; font-size: .68rem; }
  .project-tile p { line-height: 1.75; }
  .cv-footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 36px; padding: clamp(54px, 7vw, 88px) 0 20px; }
  .cv-footer h2 { margin: 18px 0 0; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .footer-links a { color: #c4d1e2; text-decoration: none; font-size: .82rem; }
  .footer-links a:hover { color: var(--mint); }
  .reveal { opacity: 0; transform: translateY(18px); transition: opacity 650ms ease, transform 650ms cubic-bezier(.2,.75,.25,1); }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }
  @media (max-width: 760px) {
    .animated-cv-shell { padding-inline: 20px; }
    .cv-topbar { align-items: flex-start; padding: 17px 0; }
    .cv-topbar-actions { align-items: flex-end; flex-direction: column; gap: 8px; }
    .live-indicator { font-size: .56rem; }
    .cv-section { grid-template-columns: 1fr; gap: 20px; padding: 42px 0; }
    .section-main h2 { margin-bottom: 25px; }
    .hero-bottom { margin-top: 48px; font-size: .55rem; }
    .cv-footer { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 520px) {
    .cv-brand { font-size: .65rem; }
    .cv-brand small { font-size: .5rem; }
    .cv-topbar-actions .live-indicator { display: none; }
    .education-grid, .skills-grid, .projects-grid { grid-template-columns: 1fr; }
    .timeline-item { grid-template-columns: 34px minmax(0, 1fr); gap: 10px; }
    .timeline-marker span { width: 28px; height: 28px; }
    .hero-bottom { flex-direction: column; gap: 8px; }
    .cv-footer h2 br { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>
