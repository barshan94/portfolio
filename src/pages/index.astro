
---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projectId = (project) => project.id.replace(/\.md$/, "");

const selectedProjectIds = [
  "money-calculator",
  "asta-store",
  "mount-royal-academy",
  "student-performance-dashboard",
  "keyword-research",
  "digital-coaching-management",
  "999-national-emergency-service",
];

const selectedOrder = new Map(
  selectedProjectIds.map((id, index) => [id, index])
);

const otherProjects = allProjects
  .filter((project) => selectedOrder.has(projectId(project)))
  .sort(
    (a, b) =>
      selectedOrder.get(projectId(a))! - selectedOrder.get(projectId(b))!
  );

const [cvEntry] = await getCollection("cv");
const cv = cvEntry?.data;


const contact = cv?.contact;
const currentYear = new Date().getFullYear();

const projectNumber = (index: number) =>
  String(index + 1).padStart(2, "0");

const getProjectLink = (project: (typeof allProjects)[number]) =>
  project.data.live || project.data.demo || project.data.url || "";

const getProjectRepo = (project: (typeof allProjects)[number]) =>
  project.data.repo || project.data.github || "";

const getProjectDemo = (project: (typeof allProjects)[number]) => {
  const demoByProject: Record<string, string> = {
    "money-calculator": "/money-calculator.html",
    "asta-store": "/asta-store-animation.html",
    "mount-royal-academy": "/mount-royal-academy-animation.html",
    "keyword-research": "/digital-growth-marketing-animation.html",
    "student-performance-dashboard": "/student-performance-dashboard.html",
    "digital-coaching-management": "/digital-coaching-management-animation.html",
    "999-national-emergency-service": "/999-emergency-service-animation.html",
  };

  return demoByProject[projectId(project)] || "";
};

const getProjectTags = (project: (typeof allProjects)[number]) =>
  Array.isArray(project.data.tags)
    ? project.data.tags.filter(
        (tag) =>
          tag.toLowerCase() !== project.data.language?.toLowerCase()
      )
    : [];

const getProjectUpdatedDate = (
  project: (typeof allProjects)[number]
) =>
  project.data.lastUpdated
    ? new Date(project.data.lastUpdated).toLocaleDateString("en-GB", {
        month: "short",
        year: "numeric",
      })
    : "";

const getExperienceDate = (experience: any) =>
  experience.period || [experience.start, experience.end].filter(Boolean).join(" — ");



---

<script>
  const revealElements = document.querySelectorAll("[data-reveal]");

  if (
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -35px 0px" }
    );

    revealElements.forEach((element) => observer.observe(element));
  } else {
    revealElements.forEach((element) => element.classList.add("is-visible"));
  }

  const yearElement = document.querySelector("#year");
  if (yearElement) {
    yearElement.textContent = String(new Date().getFullYear());
  }
</script>

<Layout
  title="Barshan Ghosh — Software Engineer · Full-Stack Developer · AI & Data"
  description="Barshan Ghosh is a software engineer and full-stack developer with interests in data analytics, artificial intelligence, machine learning, and practical software systems."
>
  
<main class="portfolio-shell">
    <!-- HERO -->
    <section class="hero section-wrap hero-editorial" id="about" aria-labelledby="hero-title">
      <div class="hero-eyebrow" data-reveal>
        <span class="hero-eyebrow-mark" aria-hidden="true"></span>
        <span>SOFTWARE ENGINEER <span aria-hidden="true">/</span> FULL-STACK DEVELOPER <span aria-hidden="true">/</span> DATA ANALYST <span aria-hidden="true">/</span> AI ENGINEER <span aria-hidden="true">/</span> MACHINE LEARNING ENGINEER</span>
      </div>

      <div class="hero-copy" data-reveal>
        <p class="hero-intro">Practical engineering. Thoughtful solutions.</p>
        <h1 id="hero-title">
          I build software that makes<br class="hero-desktop-break" />
          <span class="accent-text">complex work simpler.</span>
        </h1>

        <p class="hero-description">
          From financial workflows to focused web applications, I turn real-world
          needs into clear, reliable software. My work spans full-stack development,
          IT operations, and applied machine learning.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#projects">
            Explore my work
            <span aria-hidden="true">↘</span>
          </a>
          <a class="button button-quiet" href="#contact">
            Get in touch <span aria-hidden="true">↗</span>
          </a>
        </div>

        <nav class="hero-quick-links" aria-label="Contact and professional profiles">
          {contact?.email && (
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          )}
          {contact?.github && (
            <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          )}
          {contact?.linkedin && (
            <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          )}
        </nav>
      </div>
    </section>

    <!-- CV DOWNLOAD -->
    <section class="cv-download section-wrap section-block" id="cv" aria-labelledby="cv-title">
      <div class="cv-download-card" data-reveal>
        <div class="cv-download-copy">
          <p class="section-kicker">CURRICULUM VITAE</p>
          <h2 id="cv-title">A clear view of my <span class="accent-text">experience.</span></h2>
          <p>
            A concise CV covering my professional experience, technical skills,
            and selected software projects.
          </p>
          <div class="cv-highlights">
            <span>Software projects · IT operations</span>
            <span>Full-stack development · Applied AI</span>
          </div>
        </div>
        <div class="cv-download-actions">
          <a class="button button-primary cv-download-button" href="/cv.pdf" download="Barshan-Ghosh-CV.pdf">
            Download CV (PDF) <span aria-hidden="true">↓</span>
          </a>
          <a class="button button-quiet cv-download-button" href="/check.html">
            Watch Animated CV <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section
      class="projects section-wrap section-block"
      id="projects"
      aria-labelledby="projects-title"
    >
      <div class="section-heading" data-reveal>
        <div>
          <p class="section-kicker">01 — SELECTED PROJECTS</p>
          <h2 id="projects-title">
            Different problems.<br />
            <span class="accent-text">Different approaches.</span>
          </h2>
        </div>
        <div class="project-heading-actions">
          <p class="section-sub">
            A focused selection of software, education, and product projects. Play a demo or inspect the source directly from each card.
          </p>
          <a class="project-archive-link" href="/projects/">
            Browse all repositories <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      {otherProjects.length > 0 ? (
        <div class="project-grid">
          {otherProjects.map((project, index) => (
            <article
              class:list={[
                "project-card",
                `project-card-${projectId(project)}`,
              ]}
              data-reveal
            >
              <div class="project-card-top">
                <span class="project-number">{projectNumber(index)}</span>
                <span class="project-category">
                  {projectId(project) === "money-calculator"
                    ? "Personal finance"
                    : projectId(project) === "asta-store"
                    ? "E-commerce"
                    : projectId(project) === "mount-royal-academy"
                      ? "Education"
                      : projectId(project) === "keyword-research"
                        ? "Digital marketing"
                        : projectId(project) === "biot-thesis"
                          ? "Thesis"
                        : projectId(project) === "student-performance-dashboard"
                          ? "Analytics"
                          : projectId(project) === "digital-coaching-management"
                            ? "Education operations"
                            : projectId(project) === "999-national-emergency-service"
                              ? "Public-service software"
                              : "Selected project"}
                </span>
              </div>

              <div class="project-art" aria-hidden="true">
                {projectId(project) === "money-calculator" ? (
                  <div class="art-money-thumbnail">
                    <img
                      src="/images/money-calculator-thumbnail.svg"
                      alt="Static preview of Money Calculator's dashboard, account balances, ledger, and cash-flow summary"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : projectId(project) === "asta-store" ? (
                  <div class="art-asta-thumbnail">
                    <img src="/images/asta-store-thumbnail.svg" alt="" loading="lazy" decoding="async" />
                  </div>
                ) : projectId(project) === "keyword-research" ? (
                  <div class="art-marketing-system">
                    <span class="marketing-art-orbit orbit-a"></span>
                    <span class="marketing-art-orbit orbit-b"></span>
                    <span class="marketing-art-node node-search">SEO</span>
                    <span class="marketing-art-node node-local">LOCAL</span>
                    <span class="marketing-art-node node-video">VIDEO</span>
                    <span class="marketing-art-node node-ads">ADS</span>
                    <span class="marketing-art-node node-content">CONTENT</span>
                    <span class="marketing-art-node node-automation">AUTOMATION</span>
                    <span class="marketing-art-core">GROWTH</span>
                  </div>
                ) : projectId(project) === "mount-royal-academy" ? (
                  <div class="art-academy-thumbnail">
                    <img src="/images/mount-royal-academy-thumbnail.svg" alt="" loading="lazy" decoding="async" />
                  </div>
                ) : projectId(project) === "biot-thesis" ? (
                  <div class="art-biot-thumbnail">
                    <img src="/images/blockchain-iot-healthcare-thumbnail.svg" alt="" loading="lazy" decoding="async" />
                  </div>
                ) : projectId(project) === "student-performance-dashboard" ? (
                  <div class="art-student-dashboard-thumbnail">
                    <img src="/images/student-performance-dashboard-thumbnail.svg" alt="" loading="lazy" decoding="async" />
                  </div>
                ) : projectId(project) === "digital-coaching-management" ? (
                  <div class="art-coaching-thumbnail">
                    <img src="/images/digital-coaching-management-thumbnail.svg" alt="" loading="lazy" decoding="async" />
                  </div>
                ) : projectId(project) === "999-national-emergency-service" ? (
                  <div class="art-emergency-thumbnail">
                    <img src="/images/999-national-emergency-service-thumbnail.svg" alt="" loading="lazy" decoding="async" />
                  </div>
                ) : (
                  <div class="art-generic">
                    <span class="generic-orbit"></span>
                    <span class="generic-core">✳</span>
                    <span class="generic-line generic-line-one"></span>
                    <span class="generic-line generic-line-two"></span>
                  </div>
                )}
              </div>

              <div class="project-card-body">
                <h3>{project.data.title}</h3>
                <p class="project-description">
                  {project.data.description}
                </p>

{(project.data.language || getProjectUpdatedDate(project)) && (
  <div class="project-meta">
    {project.data.language && (
      <span class="project-language">
        <i aria-hidden="true"></i>
        {project.data.language}
      </span>
    )}
    {getProjectUpdatedDate(project) && (
      <span>Updated {getProjectUpdatedDate(project)}</span>
    )}
  </div>
)}


                {getProjectTags(project).length > 0 && (
                  <div class="tag-list project-tags">
                    {getProjectTags(project).slice(0, 5).map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                )}

                <div class="project-card-links">
                  {getProjectLink(project) && (
                    <a
                      href={getProjectLink(project)}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      View project <span aria-hidden="true">↗</span>
                    </a>
                  )}

                  {getProjectRepo(project) && (
                    <a
                      href={getProjectRepo(project)}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Source code <span aria-hidden="true">↗</span>
                    </a>
                  )}

                  {getProjectDemo(project) && (
                    <a
                      class="project-demo-link"
                      href={getProjectDemo(project)}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Play demo: ${project.data.title}`}
                    >
                      <span aria-hidden="true">▶</span> Play demo
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state" data-reveal>
          <span class="empty-mark">✳</span>
          <p>More projects will appear here as they are added to the portfolio.</p>
        </div>
      )}
    </section>


    <!-- EXPERIENCE -->
    {cv?.experience?.length && (
      <section
        class="experience section-wrap section-block"
        id="experience"
        aria-labelledby="experience-title"
      >
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-kicker">02 — EXPERIENCE</p>
            <h2 id="experience-title">
              Experience across <span class="accent-text">technology &amp; education.</span>
            </h2>
          </div>
          <p class="section-sub">
            The roles and experiences that have shaped how I work, learn,
            and approach technical problems.
          </p>
        </div>

        <div class="experience-grid">
          {cv.experience.map((experience, index) => (
            <article class="experience-card" data-reveal>
              <div class="experience-card-top">
                <span class="experience-number">{projectNumber(index)}</span>
                {experience.employmentType && (
                  <span class="experience-employment">{experience.employmentType}</span>
                )}
              </div>
              <p class="experience-period">{getExperienceDate(experience)}</p>
              <h3>{experience.role || experience.title}</h3>
              <p class="experience-company">
                {experience.org || experience.company || experience.organization}
              </p>
              <div class="experience-card-meta">
                {experience.location && <span>{experience.location}</span>}
              </div>
              {experience.description && (
                <p class="experience-description">{experience.description}</p>
              )}
              {(experience.bullets?.length || experience.highlights?.length) && (
                <ul class="experience-highlights">
                  {(experience.bullets || experience.highlights || []).map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- SKILLS -->
    {cv?.skills?.length && (
      <section
        class="skills section-wrap section-block"
        id="skills"
        aria-labelledby="skills-title"
      >
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-kicker">03 — TOOLKIT</p>
            <h2 id="skills-title">
              Tools for <span class="accent-text">the work.</span>
            </h2>
          </div>
          <p class="section-sub">
            Technologies and practical skills used across software development,
            education, IT operations, and digital growth.
          </p>
        </div>

        <div class="skills-grid">
          {cv.skills.map((skill, index) => (
            <article class="skill-card" data-reveal>
              <span class="skill-index">{projectNumber(index)}</span>
              <div class="skill-content">
                <h3>{skill.group || skill.category || skill.name || skill.title}</h3>
                {Array.isArray(skill.items) ? (
                  <div class="skill-tags">
                    {skill.items.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                ) : Array.isArray(skill.skills) ? (
                  <div class="skill-tags">
                    {skill.skills.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                ) : typeof skill === "string" ? (
                  <div class="skill-tags"><span>{skill}</span></div>
                ) : skill.description ? (
                  <p>{skill.description}</p>
                ) : null}
              </div>
              <span class="skill-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- CONTACT -->
    <section
      class="contact section-wrap section-block"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="contact-wrap" data-reveal>
        <div class="contact-copy">
          <p class="section-kicker">04 — CONTACT</p>
          <h2 id="contact-title">
            Have a good<br />
            <span class="accent-text">problem to solve?</span>
          </h2>
          <p>
            I'm interested in thoughtful projects, opportunities to grow,
            and conversations about software and AI. If something comes to mind,
            let's talk.
          </p>

          <div class="contact-links">
            {contact?.email && (
              <a
                class="contact-link contact-email"
                href={`mailto:${contact.email}`}
              >
                <span>{contact.email}</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}

            {contact?.github && (
              <a
                class="contact-link"
                href={contact.github.startsWith("http")
                  ? contact.github
                  : `https://github.com/${contact.github.replace(/^@/, "")}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>GitHub</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}

            {contact?.linkedin && (
              <a
                class="contact-link"
                href={contact.linkedin.startsWith("http")
                  ? contact.linkedin
                  : `https://www.linkedin.com/in/${contact.linkedin.replace(/^@/, "")}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>LinkedIn</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}


            {contact?.phone && (
              <a class="contact-link" href={`tel:${contact.phone.replace(/[^+\d]/g, "")}`}>
                <span>{contact.phone}</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}

          </div>
        </div>

        <div class="contact-art" aria-hidden="true">
          <img
            src="/images/contact-thumbnail.svg"
            alt=""
            loading="lazy"
            decoding="async"
            width="1600"
            height="1200"
          />
        </div>
      </div>
    </section>

    <!-- Shared site footer is rendered by Layout.astro. -->
  </main>

