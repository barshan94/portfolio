---
import Layout from '../layouts/Layout.astro';
import MoneyCalculatorTransition from '../components/MoneyCalculatorTransition.astro';
---

<Layout title="Barshan's Portfolio">
  <main class="container mx-auto px-4 py-8">
    <section class="flagship-section my-16">
      <div class="flagship-card bg-zinc-900 border border-zinc-800 rounded-2xl p-8 shadow-2xl">
        <div class="flagship-content">
          <div class="inline-block px-3 py-1 mb-4 text-xs font-semibold tracking-wider text-emerald-400 uppercase bg-emerald-950/50 rounded-full border border-emerald-800/50">
            Featured Project
          </div>
          <h2 class="text-3xl font-bold text-white mb-4">Money Calculator</h2>
          <p class="text-zinc-300 mb-6 leading-relaxed">
            A real-time financial calculation and ledger simulation engine built with high-performance canvas rendering and responsive UI components.
          </p>
          <div class="mb-8">
            <MoneyCalculatorTransition />
          </div>
          <div class="flex flex-wrap gap-4 items-center">
            <a href="https://github.com/Barshan" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors">
              View Source
            </a>
            <span class="text-xs text-zinc-500">Demo uses sample figures and is not live account data.</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .flagship-card {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .flagship-content {
    width: 100%;
  }
</style>
