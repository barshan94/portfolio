
---
import Layout from "../layouts/Layout.astro";
import MoneyCalculatorTransition from "../components/MoneyCalculatorTransition.astro";
import { digitalMarketingRepos } from "../data/digital-marketing-projects";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projectId = (project) => project.id.replace(/\.md$/, "");

const flagship =
  allProjects.find((project) => projectId(project) === "money-calculator") ||
  allProjects.find((project) =>
    project.data.title.toLowerCase().includes("money")
  ) ||
  allProjects[0];

const otherProjects = allProjects.filter(
  (project) =>
    project !== flagship &&
    // Keyword research is part of the unified Digital Marketing & Growth Systems project.
    projectId(project) !== "keyword-research"
);

const [cvEntry] = await getCollection("cv");
const cv = cvEntry?.data;

const writing = await getCollection("writing");

const contact = cv?.contact;
const currentYear = new Date().getFullYear();

const projectNumber = (index: number) =>
  String(index + 1).padStart(2, "0");

const getProjectLink = (project: (typeof allProjects)[number]) =>
  project.data.live || project.data.demo || project.data.url || "";

const getProjectRepo = (project: (typeof allProjects)[number]) =>
  project.data.repo || project.data.github || "";

const getProjectTags = (project: (typeof allProjects)[number]) =>
  Array.isArray(project.data.tags)
    ? project.data.tags.filter(
        (tag) =>
          tag.toLowerCase() !== project.data.language?.toLowerCase()
      )
    : [];

const getProjectUpdatedDate = (
  project: (typeof allProjects)[number]
) =>
  project.data.lastUpdated
    ? new Date(project.data.lastUpdated).toLocaleDateString("en-GB", {
        month: "short",
        year: "numeric",
      })
    : "";

const getExperienceDate = (experience: any) =>
  [experience.start, experience.end].filter(Boolean).join(" — ");

const getWritingLink = (entry: (typeof writing)[number]) =>
  entry.data.url || `/writing/${entry.id}/`;


---

<script>
  const revealElements = document.querySelectorAll("[data-reveal]");

  if (
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            currentObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -35px 0px" }
    );

    revealElements.forEach((element) => observer.observe(element));
  } else {
    revealElements.forEach((element) => element.classList.add("is-visible"));
  }

  const yearElement = document.querySelector("#year");
  if (yearElement) {
    yearElement.textContent = String(new Date().getFullYear());
  }
</script>

