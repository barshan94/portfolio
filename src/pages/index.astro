---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const flagship =
  allProjects.find((p) => p.slug === "money-calculator") ||
  allProjects.find((p) => p.data.title.toLowerCase().includes("money")) ||
  allProjects[0];
const otherProjects = allProjects.filter((p) => p !== flagship);
const [cvEntry] = await getCollection("cv");
const cv = cvEntry?.data;
const writing = await getCollection("writing");
---

<script>
  // Scroll-triggered reveal for .reveal elements. No JS dependency, no build step.
  if (typeof window !== "undefined" && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  }
</script>

<Layout
  title="Barshan Ghosh — Software Developer"
  description="Building practical software. Exploring intelligent systems. B.Sc. Computer Science, AIUB. Full-stack developer working toward AI engineering."
>
  <div class="portfolio-shell">

    <!-- 1. HERO -->
    <section id="about" class="hero reveal">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="hero-eyebrow reveal" data-delay="0">Software Engineer · AI Engineering</span>
          <h1 class="hero-title reveal" data-delay="60">
            Building software<br />
            that ships,<br />
            <span class="hero-accent">and stays honest.</span>
          </h1>
          <p class="hero-desc reveal" data-delay="180">
            Full-stack developer and B.Sc. Computer Science graduate (AIUB, CGPA 3.83/4.00).
            I build production systems — from auditable financial platforms to e-commerce
            and research tooling — and I write about the problems underneath.
          </p>
          <div class="hero-actions reveal" data-delay="300">
            <a href="#flagship" class="btn btn-primary">View Money Calculator ↗</a>
            <a href="#projects" class="btn btn-secondary">All projects</a>
          </div>
          <div class="hero-meta reveal" data-delay="420">
            <div class="meta-item"><strong>3+</strong><span>years shipping</span></div>
            <div class="meta-item"><strong>6</strong><span>systems built</span></div>
            <div class="meta-item"><strong>Open</strong><span>to work</span></div>
          </div>
        </div>

        <div class="hero-visual reveal" data-delay="240">
          <div class="hero-visual-frame">
            <div class="frame-glow"></div>
            <div class="frame-inner">
              <div class="frame-head">
                <span class="frame-dot"></span>
                <span class="frame-dot"></span>
                <span class="frame-dot"></span>
                <span class="frame-title">bg — personal site</span>
              </div>
              <div class="frame-body">
                <div class="frame-line w70"></div>
                <div class="frame-line w90"></div>
                <div class="frame-line w55"></div>
                <div class="frame-line w80"></div>
                <div class="frame-line w45"></div>
                <div class="frame-tag">// auditable · shipped · maintained</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. FLAGSHIP: MONEY CALCULATOR -->
    <section id="flagship" class="flagship reveal">
      <div class="container flagship-grid">
        <div class="flagship-copy">
          <span class="section-eyebrow reveal">Flagship · Financial Software</span>
          <h2 class="section-title reveal" data-delay="60">Money Calculator</h2>
          <p class="section-sub reveal" data-delay="180">
            A personal financial management platform built for correctness, not
            presentation. Every figure on screen comes from real database records —
            nothing is estimated or hardcoded.
          </p>

          <div class="spec-grid reveal" data-delay="300">
            <div class="spec-block">
              <h3>Architecture &amp; stack</h3>
              <p>Next.js 16 App Router · TypeScript · React 19 · Supabase SSR · PostgreSQL RPC · Tailwind CSS · Recharts.</p>
            </div>
            <div class="spec-block">
              <h3>What it does</h3>
              <ul>
                <li>Double-entry ledger with multi-account balance tracking</li>
                <li>Loan lifecycle management (lent &amp; borrowed) and asset tracking</li>
                <li>Tuition tracking with recurring transaction execution</li>
                <li>Natural-language AI assistant for financial queries</li>
              </ul>
            </div>
          </div>

          <div class="flagship-links reveal" data-delay="420">
            {flagship?.data.repo && (
              <a href={flagship.data.repo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Source code ↗
              </a>
            )}
            <a href="#projects" class="btn btn-secondary">See the rest →</a>
          </div>
        </div>

        <div class="flagship-visual reveal" data-delay="240">
          <div class="dash-frame">
            <div class="dash-glow"></div>
            <div class="dash-inner">
              <div class="dash-head">
                <div class="dash-dots"><span></span><span></span><span></span></div>
                <span class="dash-title">money-calculator · dashboard</span>
                <span class="dash-live"><i></i> concept visualization</span>
              </div>

              <div class="dash-panels">
                <div class="dash-panel">
                  <span class="dash-lbl">Total accounts</span>
                  <span class="dash-num">6</span>
                  <span class="dash-sub">across checking, savings, assets</span>
                </div>
                <div class="dash-panel">
                  <span class="dash-lbl">Ledger entries</span>
                  <span class="dash-num">1,248</span>
                  <span class="dash-sub">double-entry, auditable</span>
                </div>
                <div class="dash-panel">
                  <span class="dash-lbl">Active loans</span>
                  <span class="dash-num">3</span>
                  <span class="dash-sub">lent + borrowed tracked</span>
                </div>
              </div>

              <div class="dash-chart-wrap">
                <div class="dash-chart-label">Monthly cash flow</div>
                <div class="dash-chart">
                  <div class="dash-bar" style="--h:38%"></div>
                  <div class="dash-bar" style="--h:62%"></div>
                  <div class="dash-bar" style="--h:48%"></div>
                  <div class="dash-bar" style="--h:80%"></div>
                  <div class="dash-bar" style="--h:70%"></div>
                  <div class="dash-bar" style="--h:95%"></div>
                  <div class="dash-bar" style="--h:60%"></div>
                </div>
              </div>

              <div class="dash-foot">
                <span class="dash-pill">RPC audited</span>
                <span class="dash-pill">RLS secured</span>
                <span class="dash-pill">Recharts</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. PROJECTS -->
    <section id="projects" class="projects reveal">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-eyebrow">Selected Works</span>
          <h2 class="section-title">Systems &amp; products</h2>
          <p class="section-sub">Production-grade applications and research, each with its own shape.</p>
        </div>

        <div class="project-showcase">

          {otherProjects.map((p, idx) => {
            const accent = p.data.accent === "accent-2" ? "var(--accent-2)" : "var(--accent)";
            const links = [
              p.data.repo && { label: "GitHub ↗", href: p.data.repo },
              p.data.live && { label: "Live ↗", href: p.data.live },
            ].filter(Boolean);

            if (p.slug === "asta-store") {
              return (
                <article class="proj proj-banner reveal" data-delay={idx * 80} key={p.id} style={{ "--accent": accent }}>
                  <div class="proj-banner-visual" aria-hidden="true">
                    <div class="banner-grid"></div>
                    <div class="banner-overlay"></div>
                    <div class="banner-glyph">◆</div>
                  </div>
                  <div class="proj-banner-copy">
                    <span class="proj-num">01 — E-commerce</span>
                    <h3 class="proj-title">{p.data.title}</h3>
                    <p class="proj-desc">{p.data.description}</p>
                    <div class="proj-tags">
                      {p.data.tags.map((t) => <span class="tag">{t}</span>)}
                    </div>
                    <div class="proj-links">
                      {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
                    </div>
                  </div>
                </article>
              );
            }

            if (p.slug === "mount-royal-academy") {
              return (
                <article class="proj proj-tall reveal" data-delay={idx * 80} key={p.id} style={{ "--accent": accent }}>
                  <div class="proj-tall-visual" aria-hidden="true">
                    <div class="tall-glyph">▲</div>
                    <div class="tall-lines">
                      <i></i><i></i><i></i><i></i>
                    </div>
                  </div>
                  <div class="proj-tall-copy">
                    <span class="proj-num">02 — Institutional</span>
                    <span class="proj-status">{p.data.status}</span>
                    <h3 class="proj-title">{p.data.title}</h3>
                    <p class="proj-desc">{p.data.description}</p>
                    <div class="proj-tags">
                      {p.data.tags.map((t) => <span class="tag">{t}</span>)}
                    </div>
                    <div class="proj-links">
                      {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
                    </div>
                  </div>
                </article>
              );
            }

            if (p.slug === "biot-thesis") {
              return (
                <article class="proj proj-editorial reveal" data-delay={idx * 80} key={p.id} style={{ "--accent": accent }}>
                  <div class="proj-ed-visual" aria-hidden="true">
                    <div class="ed-ring"></div>
                    <div class="ed-ring ed-ring-2"></div>
                    <span class="ed-glyph">◎</span>
                  </div>
                  <div class="proj-ed-copy">
                    <span class="proj-num">03 — Research</span>
                    <span class="proj-type">{p.data.tags[0] || "Project"}</span>
                    <h3 class="proj-title">{p.data.title}</h3>
                    <p class="proj-desc">{p.data.description}</p>
                    <div class="proj-tags">
                      {p.data.tags.map((t) => <span class="tag">{t}</span>)}
                    </div>
                    <div class="proj-links">
                      {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
                    </div>
                  </div>
                </article>
              );
            }

            return (
              <article class="proj proj-card reveal" data-delay={idx * 80} key={p.id} style={{ "--accent": accent }}>
                <div class="proj-card-head">
                  <span class="proj-num">0{idx + 4}</span>
                  <span class="proj-status">{p.data.status}</span>
                </div>
                <h3 class="proj-title">{p.data.title}</h3>
                <p class="proj-desc">{p.data.description}</p>
                <div class="proj-tags">
                  {p.data.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
                <div class="proj-links">
                  {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 4. BACKGROUND & EXPERIENCE (EDITORIAL TIMELINE) -->
    <section id="experience" class="exp-section">
      <div class="container exp-grid">
        <div class="exp-intro">
          <div class="section-badge">Experience & Background</div>
          <h2 class="section-heading">Professional Journey</h2>
          <p class="section-sub">A track record spanning education, IT infrastructure, AI research, and digital engineering.</p>
        </div>

        <div class="exp-timeline">
          {cv?.experience.map((exp) => (
            <div class="timeline-item">
              <span class="exp-period">{exp.period}</span>
              <h3 class="exp-role">{exp.role}</h3>
              <p class="exp-org">{exp.org} {exp.location ? `— ${exp.location}` : ""}</p>
              <ul class="exp-bullets">
                {exp.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. TECHNICAL CAPABILITIES (STACK MANIFEST) -->
    <section id="skills" class="skills-section">
      <div class="container">
        <div class="section-badge">Capabilities</div>
        <h2 class="section-heading">Technical Stack</h2>
        <p class="section-sub">Core technologies and frameworks applied across production systems.</p>

        <div class="stack-manifest">
          {cv?.skills.map((group) => (
            <div class="stack-group">
              <h4 class="group-title">{group.group}</h4>
              <div class="group-chips">
                {group.items.map((item) => (
                  <span class="chip">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. WRITING -->
    <section id="writing" class="writing reveal">
      <div class="container">
        <div class="section-head reveal">
          <span class="section-eyebrow">Research &amp; notes</span>
          <h2 class="section-title">Writing</h2>
          <p class="section-sub">Technical documentation and research papers.</p>
        </div>

        <div class="writing-list">
          {writing.map((w, idx) => (
            <article class="writing-item reveal" data-delay={idx * 100} key={w.id}>
              <span class="writing-num">0{idx + 1}</span>
              <div class="writing-content">
                <span class="writing-type">{w.data.type}</span>
                <h3 class="writing-title">{w.data.title}</h3>
                <p class="writing-excerpt">{w.data.excerpt}</p>
              </div>
              {w.data.link ? (
                <a href={w.data.link} target="_blank" rel="noopener" class="writing-link">
                  Read <span class="wl-arrow">↗</span>
                </a>
              ) : (
                <span class="writing-link wl-disabled">Unavailable</span>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. CONTACT -->
    <section id="contact" class="contact reveal">
      <div class="container contact-wrap">
        <div class="contact-left reveal">
          <span class="section-eyebrow">Get in touch</span>
          <h2 class="contact-title">Let's build<br />something <span class="hero-accent">reliable.</span></h2>
          <p class="contact-desc">
            Open to software engineering, full-stack development, and AI engineering
            opportunities. If you're building something that needs an honest, careful
            hand, say hello.
          </p>
        </div>
        <div class="contact-right reveal" data-delay="200">
          <div class="contact-links">
            {cv?.contact?.email && (
              <a href={`mailto:${cv.contact.email}`} class="btn btn-primary">
                {cv.contact.email}
              </a>
            )}
            {cv?.contact?.github && (
              <a href={cv.contact.github} target="_blank" rel="noopener" class="btn btn-secondary">
                GitHub ↗
              </a>
            )}
            {cv?.contact?.linkedin && (
              <a href={cv.contact.linkedin} target="_blank" rel="noopener" class="btn btn-secondary">
                LinkedIn ↗
              </a>
            )}
          </div>
          <div class="contact-foot">
            <span>© <span id="year"></span> Barshan Ghosh</span>
            <span class="cf-dot">·</span>
            <span>Built with Astro</span>
          </div>
        </div>
      </div>
    </section>

  </div>

  <style>
    /* Cinematic Design System */
    .portfolio-shell {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-sans);
      overflow-x: hidden;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .section-badge {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }

    .section-heading {
      font-size: clamp(2.2rem, 4vw, 3.5rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--ink);
      margin: 0 0 1rem 0;
    }

    .section-sub {
      font-size: var(--step-2);
      color: var(--ink-muted);
      max-width: 600px;
      margin-bottom: 3rem;
    }

    /* 1. Hero Section */
    .hero-section {
      padding: clamp(6rem, 15vh, 12rem) 0;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 4rem;
    }

    .hero-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--accent);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 1.5rem;
    }

    .hero-title {
      font-size: clamp(3rem, 6.5vw, 5.5rem);
      font-weight: 800;
      line-height: 1.02;
      letter-spacing: -0.04em;
      color: var(--ink);
      margin: 0 0 2rem 0;
    }

    .hero-gradient {
      background: linear-gradient(135deg, var(--ink) 0%, var(--ink-muted) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-desc {
      font-size: var(--step-2);
      color: var(--ink-muted);
      line-height: 1.6;
      max-width: 560px;
      margin-bottom: 2.5rem;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn-cta {
      padding: 0.875rem 1.75rem;
      border-radius: var(--radius);
      font-weight: 600;
      font-size: var(--step-1);
      text-decoration: none;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    .btn-cta.primary {
      background: var(--ink);
      color: var(--bg);
    }
    .btn-cta.primary:hover { background: var(--accent); color: #fff; transform: translateY(-2px); }

    .btn-cta.secondary {
      border: 1px solid var(--line-strong);
      color: var(--ink);
      background: var(--surface);
    }
    .btn-cta.secondary:hover { border-color: var(--accent); transform: translateY(-2px); }

    /* Hero Canvas */
    .hero-canvas {
      position: relative;
    }

    .canvas-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-xl);
      position: relative;
      overflow: hidden;
    }

    .card-glow {
      position: absolute;
      top: -50px; right: -50px;
      width: 200px; height: 200px;
      background: var(--accent);
      filter: blur(80px);
      opacity: 0.15;
      pointer-events: none;
    }

    .canvas-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--line);
    }

    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .dot.red { background: #ff5f56; }
    .dot.yellow { background: #ffbd2e; }
    .dot.green { background: #27c93f; }
    .canvas-title { margin-left: auto; font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-faint); }

    .canvas-code {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      line-height: 1.7;
      color: var(--ink-2);
    }
    .code-line { display: block; }
    .code-line.indent { padding-left: 1.5rem; }
    .keyword { color: #ff7b72; }
    .class { color: #79c0ff; }
    .string { color: #a5d6ff; }
    .function { color: #d2a8ff; }

    /* 2. Flagship Section */
    .flagship-section {
      padding: 8rem 0;
      background: var(--bg-soft);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .flagship-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      margin-top: 2rem;
    }

    .flagship-specs {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .spec-block h3 {
      font-size: var(--step-2);
      color: var(--ink);
      margin-bottom: 0.5rem;
    }
    .spec-block p, .spec-block ul {
      color: var(--ink-muted);
      font-size: var(--step-1);
      line-height: 1.6;
      margin: 0;
    }
    .spec-block ul {
      padding-left: 1.2rem;
    }
    .spec-block li {
      margin-bottom: 0.35rem;
    }

    .flagship-links {
      display: flex;
      gap: 1rem;
    }

    .link-btn {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
    }
    .link-btn.primary { background: var(--accent); color: var(--bg); }
    .link-btn.primary:hover { opacity: 0.9; }
    .link-btn.secondary { border: 1px solid var(--line-strong); color: var(--ink); }
    .link-btn.secondary:hover { border-color: var(--accent); }

    /* Flagship Preview Mockup */
    .flagship-preview {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-lg);
    }

    .mockup-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-muted);
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .mockup-status { color: var(--accent-2); }

    .mockup-dashboard {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .dash-stat {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .stat-lbl { font-family: var(--font-mono); font-size: 0.65rem; color: var(--ink-faint); }
    .stat-val { font-size: 1.8rem; font-weight: 700; font-family: var(--font-mono); color: var(--ink); }
    .stat-trend { font-size: 0.75rem; color: var(--accent-2); }

    .dash-chart {
      display: flex;
      align-items: flex-end;
      gap: 0.5rem;
      height: 70px;
      padding-top: 1rem;
      border-top: 1px dashed var(--line);
    }
    .bar { flex: 1; background: var(--line-strong); border-radius: 4px 4px 0 0; }
    .bar.active { background: var(--accent); }

    .dash-footer {
      display: flex;
      gap: 0.5rem;
    }
    .pill {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      padding: 0.2rem 0.5rem;
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--ink-muted);
    }

    /* 3. Projects Showcase */
    .projects-section {
      padding: 8rem 0;
    }

    .asymmetric-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(220px, auto);
