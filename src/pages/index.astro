---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const flagship = allProjects.find((p) => p.slug === "money-calculator" || p.data.title.toLowerCase().includes("money")) || allProjects[0];
const otherProjects = allProjects.filter((p) => p !== flagship);
const [cvEntry] = await getCollection("cv");
const cv = cvEntry?.data;
const writing = await getCollection("writing");
---

<Layout
  title="Barshan Ghosh — Software Developer"
  description="Building practical software. Exploring intelligent systems. B.Sc. Computer Science, AIUB. Full-stack developer working toward AI engineering."
>
  <div class="portfolio-shell">

    <!-- 1. CINEMATIC EDITORIAL HERO -->
    <section id="about" class="hero-section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="hero-eyebrow">SOFTWARE ENGINEERING & SYSTEMS</span>
          <h1 class="hero-title">
            Building practical software.<br />
            <span class="hero-gradient">Engineering intelligent systems.</span>
          </h1>
          <p class="hero-desc">
            Full-stack developer focused on auditable software architecture, Supabase ecosystems, and AI engineering. B.Sc. Computer Science, AIUB (CGPA 3.83/4.00).
          </p>
          <div class="hero-actions">
            <a href="#flagship" class="btn-cta primary">Explore Flagship System</a>
            <a href="#projects" class="btn-cta secondary">View All Projects</a>
          </div>
        </div>

        <div class="hero-canvas">
          <div class="canvas-card">
            <div class="card-glow"></div>
            <div class="canvas-header">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="canvas-title">architecture.ts</span>
            </div>
            <div class="canvas-code">
              <span class="code-line"><span class="keyword">const</span> system = <span class="keyword">new</span> <span class="class">AppRouter</span>(&#123;</span>
              <span class="code-line indent">db: <span class="string">"PostgreSQL & Supabase SSR"</span>,</span>
              <span class="code-line indent">security: <span class="string">"Row Level Security (RLS)"</span>,</span>
              <span class="code-line indent">integrity: <span class="string">"Auditable RPC Functions"</span>,</span>
              <span class="code-line">&#125;);</span>
              <span class="code-line"><span class="keyword">await</span> system.<span class="function">deploy</span>(&#123; mode: <span class="string">"production"</span> &#125;);</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. FLAGSHIP CASE STUDY: MONEY CALCULATOR -->
    <section id="flagship" class="flagship-section">
      <div class="container">
        <div class="section-badge">Flagship Case Study 01</div>
        <h2 class="section-heading">Money Calculator</h2>
        <p class="section-sub">A comprehensive personal financial management platform with strict database auditability and real-time insights.</p>

        <div class="flagship-grid">
          <div class="flagship-specs">
            <div class="spec-block">
              <h3>Architecture & Stack</h3>
              <p>Next.js 16 App Router, TypeScript, React 19, Supabase SSR, PostgreSQL RPC, Tailwind CSS, Recharts.</p>
            </div>
            <div class="spec-block">
              <h3>Core Capabilities</h3>
              <ul>
                <li>Double-entry ledger & multi-account balance tracking</li>
                <li>Loan lifecycle management (lent/borrowed) & asset tracking</li>
                <li>Tuition tracking and recurring transaction cron execution</li>
                <li>Natural-language AI financial query assistant</li>
              </ul>
            </div>
            <div class="flagship-links">
              {flagship?.data.live && (
                <a href={flagship.data.live} target="_blank" rel="noopener noreferrer" class="link-btn primary">
                  Live Application ↗
                </a>
              )}
              {flagship?.data.repo && (
                <a href={flagship.data.repo} target="_blank" rel="noopener noreferrer" class="link-btn secondary">
                  Source Code ↗
                </a>
              )}
            </div>
          </div>

          <div class="flagship-preview">
            <div class="preview-mockup">
              <div class="mockup-bar">
                <span>Dashboard / Financial Intelligence</span>
                <span class="mockup-status">Production Verified</span>
              </div>
              <div class="mockup-dashboard">
                <div class="dash-stat">
                  <span class="stat-lbl">NET BALANCE</span>
                  <span class="stat-val">$24,850.00</span>
                  <span class="stat-trend">+14.2% this month</span>
                </div>
                <div class="dash-chart">
                  <div class="bar" style="height: 40%"></div>
                  <div class="bar" style="height: 65%"></div>
                  <div class="bar" style="height: 50%"></div>
                  <div class="bar" style="height: 85%"></div>
                  <div class="bar active" style="height: 100%"></div>
                </div>
                <div class="dash-footer">
                  <span class="pill">RPC Audited</span>
                  <span class="pill">RLS Secured</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. PROJECT SHOWCASE (ASTA, MRA, THESIS, & SYSTEMS) -->
    <section id="projects" class="projects-section">
      <div class="container">
        <div class="section-badge">Selected Works</div>
        <h2 class="section-heading">Systems & Products</h2>
        <p class="section-sub">Production-grade applications and research built with rigorous technical standards.</p>

        <div class="asymmetric-grid">
          {otherProjects.map((p, idx) => (
            <article class={`project-tile tile-${idx + 1}`} style={{ "--tile-accent": p.data.accent === "accent-2" ? "var(--accent-2)" : "var(--accent)" }} key={p.id}>
              <div class="tile-header">
                <span class="tile-index">0{idx + 2}</span>
                <span class="tile-status">{p.data.status}</span>
              </div>
              <h3 class="tile-title">{p.data.title}</h3>
              <p class="tile-desc">{p.data.description}</p>

              <div class="tile-tags">
                {p.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <div class="tile-links">
                {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
                {p.data.live && <a href={p.data.live} target="_blank" rel="noopener noreferrer">Live Demo ↗</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. BACKGROUND & EXPERIENCE (EDITORIAL TIMELINE) -->
    <section id="experience" class="exp-section">
      <div class="container exp-grid">
        <div class="exp-intro">
          <div class="section-badge">Experience & Background</div>
          <h2 class="section-heading">Professional Journey</h2>
          <p class="section-sub">A track record spanning education, IT infrastructure, AI research, and digital engineering.</p>
        </div>

        <div class="exp-timeline">
          {cv?.experience.map((exp) => (
            <div class="timeline-item">
              <span class="exp-period">{exp.period}</span>
              <h3 class="exp-role">{exp.role}</h3>
              <p class="exp-org">{exp.org} {exp.location ? `— ${exp.location}` : ""}</p>
              <ul class="exp-bullets">
                {exp.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. TECHNICAL CAPABILITIES (STACK MANIFEST) -->
    <section id="skills" class="skills-section">
      <div class="container">
        <div class="section-badge">Capabilities</div>
        <h2 class="section-heading">Technical Stack</h2>
        <p class="section-sub">Core technologies and frameworks applied across production systems.</p>

        <div class="stack-manifest">
          {cv?.skills.map((group) => (
            <div class="stack-group">
              <h4 class="group-title">{group.group}</h4>
              <div class="group-chips">
                {group.items.map((item) => (
                  <span class="chip">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. WRITING & RESEARCH -->
    <section id="writing" class="writing-section">
      <div class="container">
        <div class="section-badge">Research & Notes</div>
        <h2 class="section-heading">Writing</h2>
        <p class="section-sub">Technical documentation and research papers.</p>

        <div class="writing-grid">
          {writing.map((w) => (
            <article class="writing-card">
              <span class="writing-type">{w.data.type}</span>
              <h3 class="writing-title">{w.data.title}</h3>
              <p class="writing-excerpt">{w.data.excerpt}</p>
              {w.data.link && (
                <a href={w.data.link} target="_blank" rel="noopener noreferrer" class="writing-link">
                  Read Document ↗
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. EDITORIAL CONTACT -->
    <section id="contact" class="contact-section">
      <div class="container contact-box">
        <span class="hero-eyebrow">GET IN TOUCH</span>
        <h2 class="section-heading">Let's build reliable software.</h2>
        <p class="section-sub">Open to software engineering, full-stack development, and AI engineering opportunities.</p>

        <div class="contact-actions">
          {cv?.contact?.email && (
            <a href={`mailto:${cv.contact.email}`} class="btn-cta primary">
              {cv.contact.email}
            </a>
          )}
          {cv?.contact?.github && (
            <a href={cv.contact.github} target="_blank" rel="noopener noreferrer" class="btn-cta secondary">
              GitHub Profile
            </a>
          )}
          {cv?.contact?.linkedin && (
            <a href={cv.contact.linkedin} target="_blank" rel="noopener noreferrer" class="btn-cta secondary">
              LinkedIn Profile
            </a>
          )}
        </div>
      </div>
    </section>

  </div>

  <style>
    /* Cinematic Design System */
    .portfolio-shell {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-sans);
      overflow-x: hidden;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .section-badge {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }

    .section-heading {
      font-size: clamp(2.2rem, 4vw, 3.5rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--ink);
      margin: 0 0 1rem 0;
    }

    .section-sub {
      font-size: var(--step-2);
      color: var(--ink-muted);
      max-width: 600px;
      margin-bottom: 3rem;
    }

    /* 1. Hero Section */
    .hero-section {
      padding: clamp(6rem, 15vh, 12rem) 0;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 4rem;
    }

    .hero-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--accent);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 1.5rem;
    }

    .hero-title {
      font-size: clamp(3rem, 6.5vw, 5.5rem);
      font-weight: 800;
      line-height: 1.02;
      letter-spacing: -0.04em;
      color: var(--ink);
      margin: 0 0 2rem 0;
    }

    .hero-gradient {
      background: linear-gradient(135deg, var(--ink) 0%, var(--ink-muted) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-desc {
      font-size: var(--step-2);
      color: var(--ink-muted);
      line-height: 1.6;
      max-width: 560px;
      margin-bottom: 2.5rem;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn-cta {
      padding: 0.875rem 1.75rem;
      border-radius: var(--radius);
      font-weight: 600;
      font-size: var(--step-1);
      text-decoration: none;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    .btn-cta.primary {
      background: var(--ink);
      color: var(--bg);
    }
    .btn-cta.primary:hover { background: var(--accent); color: #fff; transform: translateY(-2px); }

    .btn-cta.secondary {
      border: 1px solid var(--line-strong);
      color: var(--ink);
      background: var(--surface);
    }
    .btn-cta.secondary:hover { border-color: var(--accent); transform: translateY(-2px); }

    /* Hero Canvas */
    .hero-canvas {
      position: relative;
    }

    .canvas-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-xl);
      position: relative;
      overflow: hidden;
    }

    .card-glow {
      position: absolute;
      top: -50px; right: -50px;
      width: 200px; height: 200px;
      background: var(--accent);
      filter: blur(80px);
      opacity: 0.15;
      pointer-events: none;
    }

    .canvas-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--line);
    }

    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .dot.red { background: #ff5f56; }
    .dot.yellow { background: #ffbd2e; }
    .dot.green { background: #27c93f; }
    .canvas-title { margin-left: auto; font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-faint); }

    .canvas-code {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      line-height: 1.7;
      color: var(--ink-2);
    }
    .code-line { display: block; }
    .code-line.indent { padding-left: 1.5rem; }
    .keyword { color: #ff7b72; }
    .class { color: #79c0ff; }
    .string { color: #a5d6ff; }
    .function { color: #d2a8ff; }

    /* 2. Flagship Section */
    .flagship-section {
      padding: 8rem 0;
      background: var(--bg-soft);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .flagship-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      margin-top: 2rem;
    }

    .flagship-specs {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .spec-block h3 {
      font-size: var(--step-2);
      color: var(--ink);
      margin-bottom: 0.5rem;
    }
    .spec-block p, .spec-block ul {
      color: var(--ink-muted);
      font-size: var(--step-1);
      line-height: 1.6;
      margin: 0;
    }
    .spec-block ul {
      padding-left: 1.2rem;
    }
    .spec-block li {
      margin-bottom: 0.35rem;
    }

    .flagship-links {
      display: flex;
      gap: 1rem;
    }

    .link-btn {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
    }
    .link-btn.primary { background: var(--accent); color: var(--bg); }
    .link-btn.primary:hover { opacity: 0.9; }
    .link-btn.secondary { border: 1px solid var(--line-strong); color: var(--ink); }
    .link-btn.secondary:hover { border-color: var(--accent); }

    /* Flagship Preview Mockup */
    .flagship-preview {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-lg);
    }

    .mockup-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-muted);
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .mockup-status { color: var(--accent-2); }

    .mockup-dashboard {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .dash-stat {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .stat-lbl { font-family: var(--font-mono); font-size: 0.65rem; color: var(--ink-faint); }
    .stat-val { font-size: 1.8rem; font-weight: 700; font-family: var(--font-mono); color: var(--ink); }
    .stat-trend { font-size: 0.75rem; color: var(--accent-2); }

    .dash-chart {
      display: flex;
      align-items: flex-end;
      gap: 0.5rem;
      height: 70px;
      padding-top: 1rem;
      border-top: 1px dashed var(--line);
    }
    .bar { flex: 1; background: var(--line-strong); border-radius: 4px 4px 0 0; }
    .bar.active { background: var(--accent); }

    .dash-footer {
      display: flex;
      gap: 0.5rem;
    }
    .pill {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      padding: 0.2rem 0.5rem;
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--ink-muted);
    }

    /* 3. Projects Showcase */
    .projects-section {
      padding: 8rem 0;
    }

    .asymmetric-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(220px, auto);
      gap: 2rem;
      margin-top: 3rem;
    }

    .project-tile {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.25s ease, border-color 0.25s ease;
      position: relative;
      overflow: hidden;
    }

    .project-tile::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      background: var(--tile-accent);
      opacity: 0.9;
    }

    .project-tile.tile-1,
    .project-tile.tile-2 {
      grid-column: 1 / -1;
    }

    .project-tile.tile-1 {
      background: var(--accent-soft);
    }

    .project-tile.tile-2 {
      background: var(--accent-2-soft);
    }

    .project-tile:hover {
      transform: translateY(-4px);
      border-color: var(--tile-accent);
    }

    .tile-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .tile-index { font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-faint); }
    .tile-status {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
      background: var(--surface-2);
      border: 1px solid var(--line);
      color: var(--accent);
    }

    .tile-title {
      font-size: var(--step-3);
      font-weight: 700;
      color: var(--ink);
      margin: 0 0 0.75rem 0;
    }

    .tile-desc {
      font-size: var(--step-1);
      color: var(--ink-muted);
      line-height: 1.6;
      margin: 0 0 2rem 0;
    }

    .tile-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
      background: var(--bg-soft);
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--ink-muted);
    }

    .tile-links {
      display: flex;
      gap: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line);
    }
    .tile-links a {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--ink-2);
      text-decoration: none;
    }
    .tile-links a:hover { color: var(--accent); }

    /* 4. Experience Section */
    .exp-section {
      padding: 8rem 0;
      background: var(--bg-soft);
      border-top: 1px solid var(--line);
    }

    .exp-grid {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
    }

    .exp-timeline {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    .timeline-item {
      position: relative;
      padding-left: 2rem;
      border-left: 2px solid var(--line);
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: -5px;
      top: 6px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }

    .exp-period {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .exp-role {
      font-size: var(--step-2);
      font-weight: 700;
      color: var(--ink);
      margin: 0.25rem 0;
    }

    .exp-org {
      font-size: var(--step-1);
      color: var(--ink-muted);
      margin-bottom: 1rem;
    }

    .exp-bullets {
      margin: 0;
      padding-left: 1.2rem;
      color: var(--ink-muted);
      font-size: var(--step-1);
      line-height: 1.6;
    }
    .exp-bullets li {
      margin-bottom: 0.35rem;
    }

    /* 5. Skills Stack Manifest */
    .skills-section {
      padding: 8rem 0;
    }

    .stack-manifest {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .stack-group {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 2rem;
    }

    .group-title {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin: 0 0 1.25rem 0;
    }

    .group-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .chip {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      padding: 0.3rem 0.75rem;
      background: var(--bg-soft);
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--ink-2);
    }

    /* 6. Writing Section */
    .writing-section {
      padding: 8rem 0;
