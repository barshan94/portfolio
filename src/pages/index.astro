    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  :global(body) {
    margin: 0;
  }

  :global(::selection) {
    color: #f7f8ff;
    background: #405ce8;
  }

  .portfolio-shell {
    --page-bg: #090b10;
    --surface: #10131b;
    --surface-raised: #141925;
    --border: rgba(214, 222, 255, 0.12);
    --text: #f1f3fb;
    --muted: #a1a9bc;
    --quiet: #717b91;
    --accent: #91a4ff;
    --accent-strong: #6078ff;
    --content-width: 1160px;

    overflow: clip;
    color: var(--text);
    background:
      radial-gradient(ellipse at 80% 0%, rgba(50, 67, 143, 0.13), transparent 35rem),
      var(--page-bg);
  }

  .section-wrap {
    width: min(var(--content-width), calc(100% - 64px));
    margin-inline: auto;
  }

  .section-block {
    padding-top: clamp(28px, 3vw, 40px);
  }

  .teaching-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 2rem; }
  .teaching-card, .education-card, .certification-card { min-width: 0; padding: 20px; border: 1px solid var(--border); border-radius: 12px; background: linear-gradient(145deg, rgba(255,255,255,.035), rgba(255,255,255,.012)); }
