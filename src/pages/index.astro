          </div>
          <p class="section-sub">
            Notes, lessons, and ideas from the things I build and learn.
          </p>
        </div>

        <div class="writing-list">
          {writing.map((entry, index) => (
            <a
              class="writing-item"
              href={getWritingLink(entry)}
              data-reveal
            >
              <span class="writing-number">{projectNumber(index)}</span>
              <div class="writing-main">
                <span class="writing-type">
                  {entry.data.type || "Article"}
                </span>
                <h3>{entry.data.title}</h3>
                {entry.data.excerpt || entry.data.description && (
                  <p>{entry.data.excerpt || entry.data.description}</p>
                )}
              </div>
              <span class="writing-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CONTACT -->
    <section
      class="contact section-wrap section-block"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="contact-wrap" data-reveal>
        <div class="contact-copy">
          <p class="section-kicker">06 — CONTACT</p>
          <h2 id="contact-title">
            Have a good<br />
            <span class="accent-text">problem to solve?</span>
          </h2>
          <p>
            I'm interested in thoughtful projects, opportunities to grow,
            and conversations about software and AI. If something comes to mind,
            let's talk.
          </p>

          <div class="contact-links">
            {contact?.email && (
              <a
                class="contact-link contact-email"
                href={`mailto:${contact.email}`}
              >
                <span>{contact.email}</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}

            {contact?.github && (
              <a
                class="contact-link"
                href={contact.github.startsWith("http")
                  ? contact.github
                  : `https://github.com/${contact.github.replace(/^@/, "")}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>GitHub</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}

            {contact?.linkedin && (
              <a
                class="contact-link"
                href={contact.linkedin.startsWith("http")
                  ? contact.linkedin
                  : `https://www.linkedin.com/in/${contact.linkedin.replace(/^@/, "")}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>LinkedIn</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>

        <div class="contact-art" aria-hidden="true">
          <div class="contact-art-orbit contact-art-orbit-one"></div>
          <div class="contact-art-orbit contact-art-orbit-two"></div>
          <div class="contact-art-core">
            <span>b<span>.</span></span>
          </div>
          <span class="contact-art-label">LET'S BUILD SOMETHING USEFUL</span>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer section-wrap">
      <a class="footer-brand" href="#about" aria-label="Back to top">
        Barshan<span>.</span>
      </a>
      <p>Built with care, curiosity, and Astro.</p>
      <a class="back-to-top" href="#about">
        Back to top <span aria-hidden="true">↑</span>
      </a>
      <span class="footer-year">© <span id="year">{currentYear}</span></span>
    </footer>
  </main>

