          href="https://github.com/barshan94/portfolio/blob/main/digital-growth-marketing-animation.html"
          target="_blank"
          rel="noopener noreferrer"
        >View GitHub source <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <!-- EXPERIENCE -->
    {cv?.experience?.length && (
      <section
        class="experience section-wrap section-block"
        id="experience"
        aria-labelledby="experience-title"
      >
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-kicker">03 — EXPERIENCE</p>
            <h2 id="experience-title">
              Learning by <span class="accent-text">doing.</span>
            </h2>
          </div>
          <p class="section-sub">
            The roles and experiences that have shaped how I work, learn,
            and approach technical problems.
          </p>
        </div>

        <div class="timeline">
          {cv.experience.map((experience, index) => (
            <article class="timeline-item" data-reveal>
              <div class="timeline-marker">
                <span>{projectNumber(index)}</span>
              </div>
              <div class="timeline-content">
                <div class="timeline-meta">
                  {getExperienceDate(experience) && (
                    <span>{getExperienceDate(experience)}</span>
                  )}
                  {experience.location && (
                    <span>{experience.location}</span>
                  )}
                </div>
                <h3>{experience.role || experience.title}</h3>
                <p class="timeline-company">
                  {experience.company || experience.organization}
                </p>
                {experience.description && (
                  <p class="timeline-description">{experience.description}</p>
                )}
                {experience.highlights?.length && (
                  <ul class="timeline-highlights">
                    {experience.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- SKILLS -->
    {cv?.skills?.length && (
      <section
        class="skills section-wrap section-block"
        id="skills"
        aria-labelledby="skills-title"
      >
        <div class="section-heading" data-reveal>
          <div>
            <p class="section-kicker">04 — TOOLKIT</p>
            <h2 id="skills-title">
              Tools for <span class="accent-text">the work.</span>
            </h2>
          </div>
          <p class="section-sub">
            Technologies and skills used across software development,
            web projects, and technical exploration.
          </p>
        </div>

        <div class="skills-grid">
          {cv.skills.map((skill, index) => (
            <article class="skill-card" data-reveal>
              <span class="skill-index">{projectNumber(index)}</span>
              <div class="skill-content">
                <h3>{skill.category || skill.name || skill.title}</h3>
                {Array.isArray(skill.items) ? (
                  <div class="skill-tags">
                    {skill.items.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                ) : Array.isArray(skill.skills) ? (
                  <div class="skill-tags">
                    {skill.skills.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                ) : typeof skill === "string" ? (
                  <div class="skill-tags"><span>{skill}</span></div>
                ) : skill.description ? (
                  <p>{skill.description}</p>
                ) : null}
              </div>
              <span class="skill-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- WRITING -->
    {writing.length > 0 && (
      <section
        class="writing section-wrap section-block"
        id="writing"
        aria-labelledby="writing-title"
      >
        <div class="section-heading" data-reveal>
