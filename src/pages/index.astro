---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
import { getCollection, getEntry } from "astro:content";

const allProjects = await getCollection("projects");
const featured = allProjects.filter((p) => p.data.featured);
const others = allProjects.filter((p) => !p.data.featured);
const [cvEntry] = await getCollection("cv");
const cv = cvEntry?.data;
const writing = await getCollection("writing");
const repoCount = 43;
---

<Layout
  title="Barshan Ghosh — Software Developer"
  description="Building practical software. Exploring intelligent systems. B.Sc. Computer Science, AIUB. Full-stack developer working toward AI engineering."
>

<!-- ================================================================
     HERO
     ================================================================ -->
<section class="hero">
  <div class="container hero-inner">
    <span class="hero-kicker reveal">{cv?.role}</span>
    <h1 class="hero-title reveal">
      {cv?.headline.split(".")[0]}.
      <br/>
      <span class="hero-accent">{cv?.headline.split(".")[1]}</span>
    </h1>
    <p class="hero-desc reveal">
      I'm a computer science graduate with a strong academic foundation and practical experience across software development, IT support, and digital marketing. I enjoy building useful applications, solving technical problems, and understanding how software works beyond the user interface. My current focus is developing reliable full-stack applications while strengthening my skills in AI and machine learning.
    </p>
    <div class="hero-actions reveal">
      <a href="#projects" class="btn btn-primary">View projects</a>
      <a href="#experience" class="btn btn-ghost">Experience</a>
    </div>
    <div class="hero-stats reveal">
      <div class="stat">
        <strong>3.83/4.00</strong>
        <span>CGPA</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <strong>3 yrs</strong>
        <span>Speedy degree</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <strong>{repoCount}</strong>
        <span>Public repos</span>
      </div>
    </div>
  </div>
</section>

<!-- ================================================================
     ABOUT
     ================================================================ -->
<div class="divider" role="separator"></div>
<section class="about" id="about">
  <div class="container">
    <SectionHeading
      eyebrow="About"
      title="A focused developer, not a generalist."
      subtitle="I don't try to be an expert in every field. I pick one direction, go deep, and let the breadth come naturally."
    />
    <div class="about-grid reveal">
      <div class="about-card">
        <h3 class="about-card-title">What I do</h3>
        <p>Full-stack web applications with clean architecture, database design, and real user value. TypeScript, Astro, Next.js, and PostgreSQL are my main tools right now.</p>
      </div>
      <div class="about-card">
        <h3 class="about-card-title">Where I'm heading</h3>
        <p>AI engineering. I'm strengthening my machine learning fundamentals, studying large language models, and building projects that apply ML to real problems.</p>
      </div>
      <div class="about-card">
        <h3 class="about-card-title">How I work</h3>
        <p>Practical. I prefer shipping working software over theoretical perfection. Every project I build is meant to be used — by people, not just machines.</p>
      </div>
      <div class="about-card">
        <h3 class="about-card-title">Background</h3>
        <p>{cv?.education[0]?.degree} ({cv?.education[0]?.cgpa}), IT support experience, digital marketing since 2020, and hands-on teaching — all of which shaped how I approach systems thinking and user-focused development.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================================================================
     EXPERIENCE
     ================================================================ -->
<div class="divider" role="separator"></div>
<section class="experience" id="experience">
  <div class="container">
    <SectionHeading
      eyebrow="Experience"
      title="Where I've worked and what I've built."
      subtitle="A mix of professional roles, internships, and personal projects — each teaching something different."
    />
    <div class="timeline reveal">
      {cv?.experience.map((exp) => (
        <TimelineEntry
          role={exp.role}
          org={exp.org + (exp.location ? ` — ${exp.location}` : "")}
          period={exp.period}
          type={exp.type}
          bullets={exp.bullets}
        />
      ))}
    </div>
  </div>
</section>

<!-- ================================================================
     PROJECTS
     ================================================================ -->
<div class="divider" role="separator"></div>
<section class="projects" id="projects">
  <div class="container">
    <SectionHeading
      eyebrow="Projects"
      title="Real applications, not tutorial clones."
      subtitle="A selection of projects built with purpose — each one solving a specific problem."
    />
    <div class="projects-grid reveal">
      {featured.map((p) => (
        <ProjectCard
          title={p.data.title}
          description={p.data.description}
          tags={p.data.tags}
          repo={p.data.repo}
          live={p.data.live}
          status={p.data.status}
          accent={p.data.accent}
        />
      ))}
      {others.map((p) => (
        <ProjectCard
          title={p.data.title}
          description={p.data.description}
          tags={p.data.tags}
          repo={p.data.repo}
          live={p.data.live}
          status={p.data.status}
          accent={p.data.accent}
        />
      ))}
    </div>
  </div>
</section>

<!-- ================================================================
     SKILLS
     ================================================================ -->
<div class="divider" role="separator"></div>
<section class="skills" id="skills">
  <div class="container">
    <SectionHeading
      eyebrow="Skills"
      title="Tools I use to get work done."
      subtitle="Focused on what matters for my current direction."
    />
    <div class="skills-grid reveal">
      {cv?.skills.map((s) => (
        <div class="skill-group">
          <h4 class="skill-group-title">{s.group}</h4>
          <p class="skill-list">{s.items.join(", ")}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ================================================================
     WRITING
     ================================================================ -->
<div class="divider" role="separator"></div>
<section class="writing" id="writing">
  <div class="container">
    <SectionHeading
      eyebrow="Writing & Research"
      title="Thoughts on technology and learning."
      subtitle="Pieces I've written down to clarify my own thinking."
    />
    <div class="writing-list reveal">
      {writing.map((w) => (
        <div class="writing-item">
          <span class="writing-label">{w.data.type}</span>
          <h4 class="writing-title">{w.data.title}</h4>
          <p class="writing-excerpt">{w.data.excerpt}</p>
          {w.data.link ? (
            <a class="writing-link" href={w.data.link} target="_blank" rel="noopener noreferrer">View →</a>
          ) : (
            <span class="writing-link">View →</span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ================================================================
     CONTACT
     ================================================================ -->
<div class="divider" role="separator"></div>
<section class="contact" id="contact">
  <div class="container">
    <div class="contact-inner reveal">
      <p class="contact-eyebrow">Contact</p>
      <h2 class="contact-title">Let's work together.</h2>
      <p class="contact-desc">
        I'm open to software engineering, full-stack development, web development, AI engineering internships, and suitable technical freelance opportunities. If you're looking for someone who ships reliable code and thinks about systems, let's talk.
      </p>
      <div class="contact-links">
        {cv?.contact?.email && <a href={`mailto:${cv.contact.email}`} class="contact-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email
        </a>}
        {cv?.contact?.github && <a href={cv.contact.github} target="_blank" rel="noopener noreferrer" class="contact-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          GitHub
        </a>}
        {cv?.contact?.linkedin && <a href={cv.contact.linkedin} target="_blank" rel="noopener noreferrer" class="contact-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>}
      </div>
      {cv?.contact?.email && <div class="contact-note">
        <span>Prefer email? </span>
        <a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
      </div>}
    </div>
  </div>
</section>

<!-- ================================================================
     SCRIPTS
     ================================================================ -->
<script>
  // IntersectionObserver for scroll-reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>

<style>
/* ---- Hero ---- */
.hero {
  padding: 6rem 0 5rem;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
}
.hero-inner { display: flex; flex-direction: column; gap: 1.5rem; max-width: 780px; }
.hero-kicker {
  margin: 0;
  font-size: var(--step-1);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
}
.hero-title {
  margin: 0;
  font-size: clamp(2.25rem, 4vw + 1rem, 3.5rem);
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--ink);
  font-weight: 800;
}
.hero-accent { color: var(--accent); }
.hero-desc {
  margin: 0;
  font-size: var(--step-2);
  color: var(--ink-muted);
  line-height: 1.7;
  max-width: 600px;
}
.hero-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.7rem 1.5rem;
  border-radius: 999px;
  font-size: var(--step-1);
  font-weight: 600;
  transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.btn:hover { transform: translateY(-2px); }
.btn-primary { background: var(--ink); color: #fff; }
.btn-primary:hover { background: var(--accent); box-shadow: var(--shadow-md); }
.btn-ghost { border: 1.5px solid var(--line-strong); color: var(--ink-2); }
.btn-ghost:hover { border-color: var(--ink-muted); color: var(--ink); background: var(--bg-soft); }
.hero-stats {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-top: 0.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--line);
}
.stat { display: flex; flex-direction: column; }
.stat strong { font-size: var(--step-3); font-weight: 700; color: var(--ink); }
.stat span { font-size: var(--step-0); color: var(--ink-faint); }
.stat-divider { width: 1px; height: 32px; background: var(--line-strong); }

/* ---- About ---- */
.about { padding: 5rem 0; }
.about-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  margin-top: 2.5rem;
}
.about-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 1.75rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.about-card:hover { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
.about-card-title {
  margin: 0 0 0.75rem;
  font-size: var(--step-2);
  font-weight: 600;
  color: var(--ink);
}
.about-card p { margin: 0; font-size: var(--step-1); color: var(--ink-muted); line-height: 1.65; }

/* ---- Timeline ---- */
.experience { padding: 5rem 0; }
.timeline {
  max-width: 720px;
  margin-top: 2.5rem;
  padding-left: 1rem;
  border-left: 2px solid var(--line-strong);
}

/* ---- Projects ---- */
.projects { padding: 5rem 0; }
.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  margin-top: 2.5rem;
}

/* ---- Skills ---- */
.skills { padding: 5rem 0; }
.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 2.5rem;
}
.skill-group {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 1.5rem;
}
.skill-group-title {
  margin: 0 0 0.6rem;
  font-size: var(--step-1);
  font-weight: 600;
  color: var(--ink);
}
.skill-list { margin: 0; font-size: var(--step-1); color: var(--ink-muted); line-height: 1.55; }

/* ---- Writing ---- */
.writing { padding: 5rem 0; }
.writing-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 2.5rem;
}
.writing-item {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 1.5rem 1.75rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.writing-item:hover { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
.writing-label {
  display: inline-block;
  font-size: var(--step-0);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.4rem;
}
.writing-title { margin: 0 0 0.4rem; font-size: var(--step-2); font-weight: 600; color: var(--ink); }
.writing-excerpt { margin: 0 0 0.75rem; font-size: var(--step-1); color: var(--ink-muted); line-height: 1.6; }
.writing-link { font-size: var(--step-1); font-weight: 500; color: var(--accent); }

/* ---- Contact ---- */
.contact { padding: 5rem 0 6rem; }
.contact-inner {
  max-width: 640px;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.contact-eyebrow {
  margin: 0;
  font-size: var(--step-1);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
}
.contact-title {
  margin: 0;
  font-size: var(--step-7);
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.contact-desc {
  margin: 0;
  font-size: var(--step-2);
  color: var(--ink-muted);
  line-height: 1.7;
}
.contact-links { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
.contact-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.7rem 1.25rem;
  border-radius: var(--radius-sm);
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink-2);
  font-size: var(--step-1);
  font-weight: 500;
  transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
}
.contact-btn:hover { border-color: var(--line-strong); background: var(--bg-soft); color: var(--ink); }
.contact-note { font-size: var(--step-1); color: var(--ink-muted); margin-top: 0.5rem; }
.contact-note a { color: var(--accent); font-weight: 500; }
.contact-note a:hover { text-decoration: underline; }

/* ---- Responsive ---- */
@media (max-width: 768px) {
  .about-grid, .projects-grid { grid-template-columns: 1fr; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); }
  .hero { padding: 4rem 0 3.5rem; }
}
@media (max-width: 480px) {
  .skills-grid { grid-template-columns: 1fr; }
  .hero-stats { flex-wrap: wrap; gap: 1rem; }
}
</style>

</Layout>
