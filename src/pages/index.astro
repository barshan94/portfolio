---
import Layout from '../layouts/Layout.astro';
import MoneyCalculatorTransition from '../components/MoneyCalculatorTransition.astro';
---

<Layout title="Barshan Ghosh — Software Engineering & Systems">
  <header class="border-b border-zinc-800 bg-zinc-950/80 backdrop-blur sticky top-0 z-50">
    <div class="container mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="font-bold text-white flex items-center gap-2">
        <span class="text-emerald-400">BG.</span>
        <span class="text-xs uppercase tracking-widest text-zinc-400 hidden sm:inline">Engineering Portfolio</span>
      </a>
      <div class="flex items-center gap-4 text-xs font-mono text-zinc-400">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          SYSTEM ONLINE
        </span>
        <span class="hidden sm:inline text-zinc-600">|</span>
        <span class="hidden sm:inline">BD / 2026</span>
      </div>
    </div>
  </header>

  <main class="container mx-auto px-4 py-8 max-w-6xl space-y-24">
    
    <!-- HERO SECTION -->
    <section class="py-12 md:py-20 grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-medium text-emerald-400 bg-emerald-950/50 rounded-full border border-emerald-800/50">
          <span>Software Engineering</span>
          <span class="text-emerald-700">/</span>
          <span>Financial Systems</span>
          <span class="text-emerald-700">/</span>
          <span>Applied AI</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Engineering useful systems for <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200">real-world problems.</span>
        </h1>
        <p class="text-zinc-300 text-lg leading-relaxed">
          I'm Barshan Ghosh, a computer science graduate who enjoys turning complicated problems into useful software. I work across web development, financial applications, and technical research while building toward a career in AI engineering.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="#flagship" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-lg transition-colors flex items-center gap-2">
            Explore my work <span>↓</span>
          </a>
          <a href="#contact" class="px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium rounded-lg transition-colors flex items-center gap-2">
            Get in touch <span>↗</span>
          </a>
        </div>
      </div>

      <!-- System Profile Card -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-2xl font-mono text-sm space-y-4">
        <div class="flex justify-between items-center text-xs text-zinc-500 border-b border-zinc-800 pb-3">
          <span class="text-emerald-400 font-semibold">ENGINEERING / SYSTEM PROFILE</span>
          <span>BG.SYS_01</span>
        </div>
        <div>
          <span class="text-xs text-zinc-500 uppercase tracking-wider">Flagship Build</span>
          <h2 class="text-xl font-bold text-white mt-1">Money Calculator</h2>
          <p class="text-xs text-zinc-400 mt-1">Personal finance workflows built around connected ledger records.</p>
        </div>
        <div class="grid grid-cols-1 gap-2 pt-2 text-xs">
          <div class="flex justify-between p-2 bg-zinc-950/60 rounded border border-zinc-800/60">
            <span class="text-zinc-400">01 / FINANCIAL LEDGER</span>
            <span class="text-emerald-400 font-semibold">IMPLEMENTED</span>
          </div>
          <div class="flex justify-between p-2 bg-zinc-950/60 rounded border border-zinc-800/60">
            <span class="text-zinc-400">02 / LOAN LIFECYCLE</span>
            <span class="text-emerald-400 font-semibold">IMPLEMENTED</span>
          </div>
          <div class="flex justify-between p-2 bg-zinc-950/60 rounded border border-zinc-800/60">
            <span class="text-zinc-400">03 / REVERSIBLE HISTORY</span>
            <span class="text-emerald-400 font-semibold">IMPLEMENTED</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FLAGSHIP PROJECT: MONEY CALCULATOR -->
    <section id="flagship" class="space-y-8">
      <div class="space-y-2">
        <span class="text-xs font-mono tracking-wider text-emerald-400 uppercase">01 — FEATURED PROJECT</span>
        <h2 class="text-3xl font-bold text-white">Money, made <span class="text-emerald-400">understandable.</span></h2>
        <p class="text-zinc-400 text-sm">Personal finance / Web application</p>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 md:p-8 shadow-2xl space-y-8">
        <div>
          <h3 class="text-2xl font-bold text-white mb-3">Money Calculator</h3>
          <p class="text-zinc-300 leading-relaxed">
            A personal finance application designed to bring everyday money activity into one place. Its development focuses on connected financial records, account balances, and tracking the lifecycle of loans and tuition payments.
          </p>
        </div>

        <!-- Embedded Interactive Cinematic Animation -->
        <div class="my-6">
          <MoneyCalculatorTransition />
        </div>

        <!-- Features Grid -->
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 pt-4 border-t border-zinc-800">
          <div class="p-3 bg-zinc-950/50 rounded-lg border border-zinc-800/60">
            <div class="text-xs font-mono text-emerald-400 font-bold mb-1">01</div>
            <h4 class="text-sm font-semibold text-white mb-1">Financial Ledger</h4>
            <p class="text-xs text-zinc-400">Organize income, expenses, donations, and account balances.</p>
          </div>
          <div class="p-3 bg-zinc-950/50 rounded-lg border border-zinc-800/60">
            <div class="text-xs font-mono text-emerald-400 font-bold mb-1">02</div>
            <h4 class="text-sm font-semibold text-white mb-1">Budgets & Goals</h4>
            <p class="text-xs text-zinc-400">Monitor spending limits and progress toward savings targets.</p>
          </div>
          <div class="p-3 bg-zinc-950/50 rounded-lg border border-zinc-800/60">
            <div class="text-xs font-mono text-emerald-400 font-bold mb-1">03</div>
            <h4 class="text-sm font-semibold text-white mb-1">Loan Tracking</h4>
            <p class="text-xs text-zinc-400">Manage lending, repayments, and student payment history.</p>
          </div>
          <div class="p-3 bg-zinc-950/50 rounded-lg border border-zinc-800/60">
            <div class="text-xs font-mono text-emerald-400 font-bold mb-1">04</div>
            <h4 class="text-sm font-semibold text-white mb-1">Audit Logs</h4>
            <p class="text-xs text-zinc-400">Improve accountability with traceable and reversible changes.</p>
          </div>
        </div>

        <!-- Tech Stack & Links -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-zinc-800">
          <div class="flex flex-wrap gap-2 text-xs font-mono">
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-300 rounded border border-zinc-700">Next.js</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-300 rounded border border-zinc-700">TypeScript</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-300 rounded border border-zinc-700">React</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-300 rounded border border-zinc-700">Supabase</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-300 rounded border border-zinc-700">PostgreSQL</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-300 rounded border border-zinc-700">Tailwind CSS</span>
          </div>
          <a href="https://github.com/barshan94/money-calculator" rel="noopener noreferrer" target="_blank" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium rounded-lg transition-colors flex items-center gap-2">
            View Source <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- SELECTED ENGINEERING WORKS -->
    <section id="projects" class="space-y-8">
      <div class="space-y-2">
        <span class="text-xs font-mono tracking-wider text-emerald-400 uppercase">02 — SELECTED WORK</span>
        <h2 class="text-3xl font-bold text-white">Different problems. <span class="text-emerald-400">Different approaches.</span></h2>
        <p class="text-zinc-400 text-sm">A focused selection of software, education, research, and product projects.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Project 1 -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 flex flex-col justify-between space-y-4 hover:border-zinc-700 transition-colors">
          <div class="space-y-3">
            <span class="text-xs font-mono text-emerald-400 uppercase">E-Commerce System</span>
            <h3 class="text-xl font-bold text-white">asta-store</h3>
            <p class="text-zinc-300 text-sm leading-relaxed">
              Astro-powered e-commerce storefront for ASTA (handmade leather bags). Features product browsing, cart management, checkout flow, and admin dashboard with Supabase auth.
            </p>
          </div>
          <div class="space-y-4 pt-4 border-t border-zinc-800">
            <div class="flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Astro</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">TypeScript</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Supabase</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Tailwind</span>
            </div>
            <a href="https://github.com/barshan94/asta-store" rel="noopener noreferrer" target="_blank" class="text-sm font-medium text-emerald-400 hover:text-emerald-300 inline-flex items-center gap-1">
              Source code <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 flex flex-col justify-between space-y-4 hover:border-zinc-700 transition-colors">
          <div class="space-y-3">
            <span class="text-xs font-mono text-emerald-400 uppercase">Research Thesis</span>
            <h3 class="text-xl font-bold text-white">Blockchain Internet of Things (bIoT)</h3>
            <p class="text-zinc-300 text-sm leading-relaxed">
              Research on blockchain healthcare security technologies and their applications and market opportunities. Explores decentralized identity, data integrity, and IoT security in clinical settings.
            </p>
          </div>
          <div class="space-y-4 pt-4 border-t border-zinc-800">
            <div class="flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Research</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Blockchain</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Healthcare Security</span>
            </div>
            <a href="https://github.com/barshan94/Thesis" rel="noopener noreferrer" target="_blank" class="text-sm font-medium text-emerald-400 hover:text-emerald-300 inline-flex items-center gap-1">
              Source code <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Project 3 -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 flex flex-col justify-between space-y-4 hover:border-zinc-700 transition-colors">
          <div class="space-y-3">
            <span class="text-xs font-mono text-emerald-400 uppercase">Education Platform</span>
            <h3 class="text-xl font-bold text-white">Mount Royal Academy Website</h3>
            <p class="text-zinc-300 text-sm leading-relaxed">
              School website with admission management, calendar, notices, gallery, and admin dashboard. Built with Astro and Supabase for content management.
            </p>
          </div>
          <div class="space-y-4 pt-4 border-t border-zinc-800">
            <div class="flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Astro</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Supabase</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">TypeScript</span>
            </div>
            <a href="https://github.com/barshan94/MountRoyalAcademy-website" rel="noopener noreferrer" target="_blank" class="text-sm font-medium text-emerald-400 hover:text-emerald-300 inline-flex items-center gap-1">
              Source code <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Project 4 -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 flex flex-col justify-between space-y-4 hover:border-zinc-700 transition-colors">
          <div class="space-y-3">
            <span class="text-xs font-mono text-emerald-400 uppercase">Core Systems</span>
            <h3 class="text-xl font-bold text-white">Various System Implementations</h3>
            <p class="text-zinc-300 text-sm leading-relaxed">
              Doctor management system (C++), library management service (Java), bank account management (Java), ride sharing management, and automated testing suites.
            </p>
          </div>
          <div class="space-y-4 pt-4 border-t border-zinc-800">
            <div class="flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">C++</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Java</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">PHP</span>
              <span class="px-2 py-0.5 bg-zinc-800 text-zinc-300 rounded">Testing</span>
            </div>
            <a href="https://github.com/barshan94" rel="noopener noreferrer" target="_blank" class="text-sm font-medium text-emerald-400 hover:text-emerald-300 inline-flex items-center gap-1">
              View GitHub Profile <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- DIGITAL GROWTH & MARKETING SYSTEMS (COLLAPSIBLE ACCORDION) -->
    <section class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 md:p-8 space-y-6">
      <div class="space-y-2">
        <span class="text-xs font-mono tracking-wider text-emerald-400 uppercase">DIGITAL AUTOMATIONS & GROWTH</span>
        <h2 class="text-2xl font-bold text-white">Growth & Marketing Toolchain (12 Repositories)</h2>
        <p class="text-zinc-400 text-sm">Supporting repositories covering SEO research, local optimization, WordPress builds, and conversational automation workflows.</p>
      </div>

      <details class="group bg-zinc-950/60 border border-zinc-800 rounded-xl overflow-hidden">
        <summary class="p-4 cursor-pointer font-medium text-white flex justify-between items-center select-none hover:bg-zinc-800/50 transition-colors">
          <span class="text-sm font-mono text-emerald-400">Expand Repository Index (SEO, WordPress, Ads & Automations)</span>
          <span class="text-xs text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="p-4 border-t border-zinc-800 grid sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
          <a href="https://github.com/barshan94/KeywordResearch" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">01 / SEO</span>
            <span class="font-medium text-white block">Keyword Research</span>
          </a>
          <a href="https://github.com/barshan94/KeywordRedearchforAmazonAffiliate" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">02 / AFFILIATE</span>
            <span class="font-medium text-white block">Amazon Affiliate Research</span>
          </a>
          <a href="https://github.com/barshan94/Google-Business-Profile" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">03 / LOCAL SEO</span>
            <span class="font-medium text-white block">Google Business Profile</span>
          </a>
          <a href="https://github.com/barshan94/ContentWriting" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">04 / CONTENT</span>
            <span class="font-medium text-white block">Content Writing</span>
          </a>
          <a href="https://github.com/barshan94/WebsiteAudit" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">05 / AUDIT</span>
            <span class="font-medium text-white block">Website Audit</span>
          </a>
          <a href="https://github.com/barshan94/OnPageOptimization" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">06 / ON-PAGE</span>
            <span class="font-medium text-white block">On-Page Optimization</span>
          </a>
          <a href="https://github.com/barshan94/YoutubeSeo" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">07 / VIDEO SEO</span>
            <span class="font-medium text-white block">YouTube SEO</span>
          </a>
          <a href="https://github.com/barshan94/CompleteWebsiteusingWordpress" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">08 / WORDPRESS</span>
            <span class="font-medium text-white block">WordPress Site Build</span>
          </a>
          <a href="https://github.com/barshan94/WebsiteCustomizationusingwordpress" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">09 / CUSTOMIZATION</span>
            <span class="font-medium text-white block">WordPress Customization</span>
          </a>
          <a href="https://github.com/barshan94/FacebookLiveAdCampaign" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">10 / ADS</span>
            <span class="font-medium text-white block">Facebook Live Ad Campaign</span>
          </a>
          <a href="https://github.com/barshan94/Design" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">11 / CREATIVE</span>
            <span class="font-medium text-white block">Design Assets</span>
          </a>
          <a href="https://github.com/barshan94/AutomationsUsingManychat" target="_blank" rel="noopener noreferrer" class="p-3 bg-zinc-900 hover:bg-zinc-800 rounded border border-zinc-800 transition-colors block">
            <span class="text-emerald-400 font-mono block mb-1">12 / AUTOMATION</span>
            <span class="font-medium text-white block">ManyChat Automations</span>
          </a>
        </div>
      </details>
    </section>

    <!-- EXPERIENCE SECTION -->
    <section id="experience" class="space-y-8">
      <div class="space-y-2">
        <span class="text-xs font-mono tracking-wider text-emerald-400 uppercase">03 — EXPERIENCE</span>
        <h2 class="text-3xl font-bold text-white">Learning by <span class="text-emerald-400">doing.</span></h2>
        <p class="text-zinc-400 text-sm">Roles and experiences that shaped my approach to software engineering and problem solving.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-3">
          <span class="text-xs font-mono text-emerald-400">ROLE 01</span>
          <h3 class="text-lg font-bold text-white">Junior ICT Teacher / IT Coordinator</h3>
          <p class="text-zinc-300 text-sm leading-relaxed">Managed technical lab environments, guided students through foundational computer science concepts, and maintained institutional IT infrastructure.</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-3">
          <span class="text-xs font-mono text-emerald-400">ROLE 02</span>
          <h3 class="text-lg font-bold text-white">Part-time IT Support Specialist</h3>
          <p class="text-zinc-300 text-sm leading-relaxed">Provided hardware and software troubleshooting, resolved network configuration issues, and ensured operational uptime for digital systems.</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-3">
          <span class="text-xs font-mono text-emerald-400">ROLE 03</span>
          <h3 class="text-lg font-bold text-white">Remote AI Engineer Intern <span class="text-xs text-zinc-500 font-normal">(Bengaluru, India)</span></h3>
          <p class="text-zinc-300 text-sm leading-relaxed">Explored prompt engineering workflows, assisted in testing AI-driven application components, and researched machine learning integration practices.</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-3">
          <span class="text-xs font-mono text-emerald-400">ROLE 04</span>
          <h3 class="text-lg font-bold text-white">Digital Marketing & Systems Specialist</h3>
          <p class="text-zinc-300 text-sm leading-relaxed">Executed technical SEO campaigns, built conversion funnels, and automated customer engagement pipelines using WordPress and social advertising.</p>
        </div>
      </div>
    </section>

    <!-- TOOLKIT SECTION -->
    <section id="toolkit" class="space-y-8">
      <div class="space-y-2">
        <span class="text-xs font-mono tracking-wider text-emerald-400 uppercase">04 — TOOLKIT</span>
        <h2 class="text-3xl font-bold text-white">Tools for <span class="text-emerald-400">the work.</span></h2>
        <p class="text-zinc-400 text-sm">Technologies and technical proficiencies used across my projects.</p>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-4">
          <h3 class="text-sm font-mono text-emerald-400 uppercase">Frontend Engineering</h3>
          <div class="flex flex-wrap gap-2 text-xs font-mono">
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-200 rounded">Astro</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-200 rounded">React</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-200 rounded">TypeScript</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-200 rounded">Tailwind CSS</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-200 rounded">HTML/CSS</span>
          </div>
        </div>

        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-4">
          <h3 class="text-sm font-mono text-emerald-400 uppercase">Backend & Database</h3>
          <div class="flex flex-wrap gap-2 text-xs font-mono">
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-200 rounded">Node.js</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-200 rounded">Supabase</span>
            <span class="px-2.5 py-1 bg-zinc-800 text-zinc-200 rounded">PostgreSQL</span>
