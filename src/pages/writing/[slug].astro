---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("writing");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} — Barshan Ghosh`} description={entry.data.excerpt}>
  <main class="writing-page">
    <a class="back-link" href="/#writing">← Back to writing &amp; research</a>
    <article>
      <p class="eyebrow">{entry.data.type} / NOTES &amp; RESEARCH</p>
      <h1>{entry.data.title}</h1>
      <p class="excerpt">{entry.data.excerpt}</p>
      <div class="article-body"><Content /></div>
      {entry.data.link && (
        <a class="source-link" href={entry.data.link} target="_blank" rel="noopener noreferrer">Open related source ↗</a>
      )}
    </article>
  </main>
</Layout>

<style>
  :global(body) { background: #080a0d; }
  .writing-page { width: min(820px, calc(100% - 36px)); min-height: 70vh; margin: 0 auto; padding: 32px 0 90px; color: #f4f4f5; }
  .back-link { display: inline-block; margin-bottom: clamp(38px, 8vw, 82px); color: #a1a1aa; font-size: .85rem; text-decoration: none; }
  .back-link:hover { color: #34d399; }
  .eyebrow { color: #a7f3d0; font: .72rem/1.6 "JetBrains Mono", monospace; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 18px 0; font-size: clamp(2.3rem, 6vw, 4.5rem); line-height: 1.04; letter-spacing: -.05em; }
  .excerpt { color: #c4c4cc; font-size: 1.08rem; line-height: 1.8; }
  .article-body { margin-top: 32px; padding-top: 22px; border-top: 1px solid #303238; color: #d4d4d8; line-height: 1.85; }
  .article-body :global(h2), .article-body :global(h3) { margin-top: 2rem; color: #f4f4f5; }
  .article-body :global(a) { color: #a7f3d0; }
  .source-link { display: inline-block; margin-top: 28px; color: #a7f3d0; text-decoration: none; }
  .source-link:hover { text-decoration: underline; }
</style>
