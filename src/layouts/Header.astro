---
const nav = [
  { number: "00", label: "ABOUT", mobileLabel: "ABOUT", href: "#about" },
  { number: "01", label: "PROJECTS", mobileLabel: "PROJECTS", href: "#projects" },
  { number: "02", label: "EXPERIENCE", mobileLabel: "EXPERIENCE", href: "#experience" },
  { number: "03", label: "TOOLKIT", mobileLabel: "TOOLKIT", href: "#skills" },
  { number: "04", label: "CONTACT", mobileLabel: "CONTACT", href: "#contact" },
];
---

<header class="system-header">
  <a href="/" class="brand" aria-label="Barshan Ghosh home">
    <span class="brand-name">Barshan Ghosh</span>
  </a>
</header>

<nav class="system-dock" aria-label="System navigation">
    {nav.map((item) => (
    <a href={item.href} class="dock-link" data-section={item.href.slice(1)} data-mobile-label={item.mobileLabel}>
      <span class="dock-number">{item.number}</span>
      <span class="dock-label">{item.label}</span>
      <span class="dock-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</nav>

<style>
  .system-header {
    position: relative;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(calc(100% - 3rem), 1440px);
    margin: 0 auto;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line, #292929);
    font-family: "JetBrains Mono", monospace;
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    color: var(--ink, #f1f1ed);
    text-align: center;
    text-decoration: none;
  }

  .brand-name {
    color: var(--ink, #f1f1ed);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  /* Desktop and tablet: a single full-width horizontal navigation row. */
  .system-dock {
    position: relative;
    z-index: 110;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.35rem;
    width: min(calc(100% - 3rem), 1440px);
    margin: 0 auto 1.25rem;
    padding: 0.4rem;
    border: 1px solid rgba(145, 164, 255, 0.2);
    border-radius: 12px;
    background: rgba(12, 16, 25, 0.94);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(16px);
    font-family: "JetBrains Mono", monospace;
  }

  .dock-link {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.8rem 0.75rem;
    border: 0;
    border-radius: 8px;
    color: var(--ink-2, #929292);
    text-decoration: none;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition: color 160ms ease, background 160ms ease;
  }

  .dock-number {
    color: #686868;
    font-size: 0.58rem;
  }

  .dock-label { display: inline; }
  .dock-arrow { opacity: 0; margin-left: 0.1rem; }
  .dock-link:hover,
  .dock-link.active {
    color: var(--ink, #f1f1ed);
    background: color-mix(in srgb, var(--accent, #c6ff4d) 8%, transparent);
  }
  .dock-link:hover .dock-number,
  .dock-link.active .dock-number { color: var(--accent, #c6ff4d); }
  .dock-link:hover .dock-arrow,
  .dock-link.active .dock-arrow { opacity: 1; color: var(--accent, #c6ff4d); }

  @media (max-width: 700px) {
    .system-header {
      width: calc(100% - 1.5rem);
      padding: 1rem 0;
    }

    /* Keep the compact, reachable bottom bar on phones. */
    .system-dock {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      max-width: none;
      margin: 0;
      justify-content: space-around;
      gap: 0.1rem;
      padding: 0.35rem 0.2rem;
      border-right: 0;
      border-bottom: 0;
      border-left: 0;
      border-radius: 12px 12px 0 0;
      box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.22);
      background: var(--surface, #101010);
    }

    .dock-link {
      flex: 1 1 0;
      flex-direction: column;
      gap: 0.12rem;
      min-width: 0;
      padding: 0.55rem 0.1rem;
    }

    .dock-number,
    .dock-arrow { display: none; }

    .dock-label {
      display: block;
      font-size: clamp(0.43rem, 2vw, 0.58rem);
      letter-spacing: 0.015em;
      line-height: 1.25;
    }

    :global(body) { padding-bottom: 58px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-link { transition: none; }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll(".dock-link"));

  const sections = links
    .map((link) => document.getElementById(link.dataset.section || ""))
    .filter((section) => section instanceof HTMLElement);

  if ("IntersectionObserver" in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            const active = link.dataset.section === entry.target.id;
            link.classList.toggle("active", active);
            if (active) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "-25% 0px -55% 0px" }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>


<style>
  /* Keep the masthead intentionally quiet: the name is the only brand element. */
  .system-header {
    justify-content: center;
    width: min(calc(100% - 3rem), 1440px);
    margin: 0 auto;
    padding: 1.35rem 0;
  }
  .brand {
    justify-content: center;
    width: 100%;
    text-align: center;
  }
  .brand-name {
    text-align: center;
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    letter-spacing: -0.045em;
  }
  @media (max-width: 600px) {
    .system-header {
      width: calc(100% - 1.5rem);
      padding: 1rem 0;
    }
  }
</style>
