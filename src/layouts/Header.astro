---
const nav = [
  { number: "01", label: "SYSTEM", href: "#about" },
  { number: "02", label: "IMPACT", href: "#flagship" },
  { number: "03", label: "PROJECTS", href: "#projects" },
  { number: "04", label: "EXPERIENCE", href: "#experience" },
  { number: "05", label: "WRITING", href: "#writing" },
  { number: "06", label: "CONTACT", href: "#contact" },
];
---

<header class="system-header">
  <a href="/" class="brand" aria-label="Barshan Ghosh home">
    <span class="brand-mark">BG<span>.</span></span>
    <span class="brand-caption">ENGINEERING PORTFOLIO</span>
  </a>

  <div class="system-status">
    <span class="status-light"></span>
    <span>SYSTEM ONLINE</span>
    <span class="status-year">BD / 2026</span>
  </div>
</header>

<nav class="system-dock" aria-label="System navigation">
  <div class="dock-heading">INDEX <span>///</span></div>
  {nav.map((item) => (
    <a href={item.href} class="dock-link" data-section={item.href.slice(1)}>
      <span class="dock-number">{item.number}</span>
      <span class="dock-label">{item.label}</span>
      <span class="dock-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
  <div class="dock-footer">BG / SYS.01</div>
</nav>

<style>
.system-header {
  position: relative;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  width: min(100% - 3rem, 1440px);
  margin: 0 auto;
  padding: 1.25rem 0;
  border-bottom: 1px solid var(--line, #292929);
  font-family: "JetBrains Mono", monospace;
}

.brand {
  display: flex;
  align-items: center;
  gap: 1rem;
  color: var(--ink, #f1f1ed);
  text-decoration: none;
}

.brand-mark {
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.08em;
}

.brand-mark span { color: var(--accent, #c6ff4d); }

.brand-caption,
.system-status {
  font-size: 0.65rem;
  letter-spacing: 0.12em;
}

.brand-caption { color: var(--ink-2, #929292); }

.system-status {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  color: var(--ink-2, #929292);
}

.status-light {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--accent, #c6ff4d);
  box-shadow: 0 0 10px color-mix(in srgb, var(--accent, #c6ff4d) 45%, transparent);
}

.status-year { margin-left: 0.75rem; }

.system-dock {
  position: fixed;
  z-index: 110;
  top: 50%;
  left: 1rem;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  width: 148px;
  padding: 0.7rem;
  border: 1px solid var(--line, #292929);
  background: var(--surface, #101010);
  font-family: "JetBrains Mono", monospace;
}

.dock-heading,
.dock-footer {
  padding: 0.55rem 0.45rem;
  color: var(--ink-2, #929292);
  font-size: 0.58rem;
  letter-spacing: 0.12em;
}

.dock-heading {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid var(--line, #292929);
  margin-bottom: 0.35rem;
}

.dock-heading span { color: var(--accent, #c6ff4d); }

.dock-link {
  display: grid;
  grid-template-columns: 1.6rem 1fr 0.8rem;
  align-items: center;
  gap: 0.3rem;
  padding: 0.7rem 0.35rem;
  border-bottom: 1px solid color-mix(in srgb, var(--line, #292929) 65%, transparent);
  color: var(--ink-2, #929292);
  text-decoration: none;
  font-size: 0.59rem;
  letter-spacing: 0.025em;
  transition: color 160ms ease, background 160ms ease;
}

.dock-number { color: #686868; }
.dock-arrow { opacity: 0; text-align: right; }
.dock-link:hover,
.dock-link.active {
  color: var(--ink, #f1f1ed);
  background: color-mix(in srgb, var(--accent, #c6ff4d) 7%, transparent);
}
.dock-link:hover .dock-number,
.dock-link.active .dock-number { color: var(--accent, #c6ff4d); }
.dock-link:hover .dock-arrow,
.dock-link.active .dock-arrow { opacity: 1; color: var(--accent, #c6ff4d); }

.dock-footer {
  padding-top: 0.8rem;
  font-size: 0.53rem;
}

@media (max-width: 1500px) {
  .system-dock {
    position: static;
    transform: none;
    width: min(100% - 3rem, 1180px);
    max-width: 1180px;
    margin: 0 auto 1rem;
    flex-direction: row;
    justify-content: space-between;
    padding: 0.35rem;
    box-shadow: none;
  }

  .dock-heading,
  .dock-footer,
  .dock-label,
  .dock-arrow { display: none; }

  .dock-link {
    display: flex;
    flex: 1;
    justify-content: center;
    padding: 0.65rem 0.25rem;
    border-bottom: 0;
    font-size: 0.62rem;
  }
}

@media (max-width: 600px) {
  .system-header {
    width: calc(100% - 2rem);
    padding: 1rem 0;
  }
  .brand-caption { display: none; }
  .system-status { font-size: 0.53rem; gap: 0.4rem; }
  .status-year { margin-left: 0.2rem; }

  .system-dock {
    top: auto;
    right: 0;
    bottom: 0;
    left: 0;
    transform: none;
    width: auto;
    max-width: none;
    margin: 0;
    box-shadow: none;
    flex-direction: row;
    justify-content: space-around;
    width: auto;
    padding: 0.35rem 0.2rem;
    border-right: 0;
    border-bottom: 0;
    border-left: 0;
    background: var(--surface, #101010);
  }
  .dock-link {
    flex: 1;
    padding: 0.8rem 0.1rem;
    border-bottom: 0;
  }
  :global(body) { padding-bottom: 54px; }
}

@media (prefers-reduced-motion: reduce) {
  .dock-link { transition: none; }
}
</style>

<script>
  const links = Array.from(document.querySelectorAll(".dock-link"));

  const sections = links
    .map((link) => document.getElementById(link.dataset.section || ""))
    .filter((section) => section instanceof HTMLElement);

  if ("IntersectionObserver" in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            const active = link.dataset.section === entry.target.id;
            link.classList.toggle("active", active);
            if (active) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "-25% 0px -55% 0px" }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
