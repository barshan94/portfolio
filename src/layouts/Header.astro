---
---

<header class="system-header">
  <a href="/" class="brand" aria-label="Barshan Ghosh home">
    <span class="brand-name">Barshan Ghosh</span>
  </a>
</header>

<style>
  .system-header {
    position: relative;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(calc(100% - 3rem), 1440px);
    margin: 0 auto;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line, #292929);
    font-family: "JetBrains Mono", monospace;
  }

  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    color: var(--ink, #f1f1ed);
    text-align: center;
    text-decoration: none;
  }

  .brand-name {
    color: var(--ink, #f1f1ed);
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  @media (max-width: 600px) {
    .system-header {
      width: calc(100% - 1.5rem);
      padding: 1rem 0;
    }
  }
</style>