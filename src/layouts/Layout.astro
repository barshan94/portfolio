---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/system-ui.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Barshan Ghosh — Software Developer",
  description = "Barshan Ghosh is a computer science graduate and software developer interested in practical web applications, financial systems, and AI engineering.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
